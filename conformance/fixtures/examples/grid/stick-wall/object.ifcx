      "attributes": {
        "bsi::ifc::class": {
          "code": "IfcCurtainWall",
          "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcCurtainWall"
        },
        "bsi::ifc::prop::Name": "Stick curtain wall (fixture)",
        "bsi::ifc::prop::TypeName": "Stick curtain wall (fixture)",
        "opo::object": {
          "id": "opo-format.org/examples/grid/stick-wall",
          "name": "Stick curtain wall (fixture)",
          "version": "0.1.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "A minimal stick curtain wall: a grid on a baseline with mullion and panel components and instance overrides.",
          "tags": [
            "grid",
            "proposal 0001"
          ],
          "references": [
            {
              "role": "conformance",
              "name": "Proposal 0001: grid systems and swappable components",
              "used": "Fixture for the grid, layout and component conformance cases."
            }
          ]
        },
        "opo::parameters": [
          {
            "name": "module",
            "type": "length",
            "default": 1.5,
            "label": "Module",
            "group": "Grid"
          },
          {
            "name": "spandrel_height",
            "type": "length",
            "default": 0.9,
            "label": "Spandrel height",
            "group": "Grid"
          },
          {
            "name": "join",
            "type": "choice",
            "default": "u_continuous",
            "options": [
              "u_continuous",
              "v_continuous"
            ],
            "label": "Join",
            "group": "Grid"
          },
          {
            "name": "frame_classes",
            "type": "component",
            "interface": "frame",
            "default": null,
            "label": "Frames",
            "group": "Components",
            "allowed": {
              "ifc_class": "IfcMember"
            },
            "classes": {
              "default": "opo-format.org/examples/grid/mullion"
            }
          },
          {
            "name": "panel_classes",
            "type": "component",
            "interface": "panel",
            "default": null,
            "label": "Panels",
            "group": "Components",
            "classes": {
              "default": "opo-format.org/examples/grid/panel"
            }
          }
        ],
        "opo::slots": [
          {
            "name": "surface",
            "type": "surface",
            "default": {
              "baseline": [[0, 0], [4.5, 0], [4.5, 3]],
              "base": 0,
              "top": 3.3
            }
          },
          {
            "name": "overrides",
            "type": "overrides",
            "default": []
          }
        ],
        "opo::rules": {
          "derived": [],
          "checks": []
        },
        "opo::recipe": [
          {
            "id": "g",
            "op": "grid",
            "args": {
              "surface": "surface",
              "u": "{pattern: [{size: module, flexible: true}], distribution: \"best_division\"}",
              "v": "{pattern: [{size: spandrel_height, cls: \"spandrel\"}, {size: 2.4, flexible: true, cls: \"vision\"}], distribution: \"best_division\"}",
              "join": "join",
              "overrides": "overrides",
              "widths": "{boundary: reported(component_for(frame_classes, \"boundary\"), \"face_width\"), mullion: reported(component_for(frame_classes, \"mullion\"), \"face_width\"), transom: reported(component_for(frame_classes, \"transom\"), \"face_width\"), corner: reported(component_for(frame_classes, \"corner\"), \"face_width\")}"
            }
          },
          {
            "id": "frames",
            "op": "for_each",
            "args": {
              "items": "g.segments",
              "as": "s",
              "do": "instance(if s.component != null then s.component else component_for(frame_classes, s.cls), if s.values != null then s.values else {}, {path: s.path, normal: s.normal, trim_start: s.trim_start, trim_end: s.trim_end, left_cell: null, right_cell: null})"
            }
          },
          {
            "id": "panels",
            "op": "for_each",
            "args": {
              "items": "g.cells",
              "as": "c",
              "do": "instance(if c.component != null then c.component else component_for(panel_classes, c.cls), if c.values != null then c.values else {}, {outline: c.panel_outline, normal: c.normal, insets: c.insets})"
            }
          }
        ],
        "opo::representations": [
          {
            "id": "model.medium",
            "context": "model",
            "lod": "medium",
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "frames",
                "part": "Frames"
              },
              {
                "geometry": "panels",
                "part": "Panels"
              }
            ]
          },
          {
            "id": "model.high",
            "context": "model",
            "lod": "high",
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "frames",
                "part": "Frames"
              },
              {
                "geometry": "panels",
                "part": "Panels"
              }
            ]
          }
        ],
        "opo::host": {
          "is_host": false,
          "nested": {
            "objects": [
              "opo-format.org/examples/grid/mullion",
              "opo-format.org/examples/grid/panel"
            ],
            "note": "Component defaults."
          }
        },
        "opo::materials": {
          "aluminium": {
            "label": "Aluminium",
            "category": "metal",
            "colour": "#b8bcc0",
            "cut": {
              "hatch": "solid_dark"
            },
            "ifc_name": "Aluminium"
          },
          "glass": {
            "label": "Glass",
            "category": "glass",
            "colour": "#bcd4dc",
            "cut": {
              "hatch": "solid_dark"
            },
            "ifc_name": "Glass"
          }
        },
        "opo::hatches": {
          "solid_dark": {
            "label": "Solid, dark",
            "kind": "solid",
            "colour": "#3a3a3a"
          }
        },
        "opo::ifc": {
          "class": "IfcCurtainWall",
          "predefinedType": "null",
          "decomposition": "IfcCurtainWall aggregating its members (IfcMember) and panels (IfcPlate)."
        }
      }
    },
