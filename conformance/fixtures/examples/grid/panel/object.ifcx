        "usd::usdgeom::mesh": {
          "points": [[0.0, -0.015, 0.0], [1.0, -0.015, 0.0], [1.0, 0.015, 0.0], [0.0, 0.015, 0.0], [0.0, -0.015, 1.0], [1.0, -0.015, 1.0], [1.0, 0.015, 1.0], [0.0, 0.015, 1.0]],
          "faceVertexIndices": [2, 0, 3, 0, 2, 1, 6, 7, 4, 4, 5, 6, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
