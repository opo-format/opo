      "children": {
        "Model_body_1": "8fd17246-5bca-542e-9f4c-651a464921fd"
      },
      "attributes": {
        "bsi::ifc::class": {
          "code": "IfcBuildingElementProxy",
          "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcBuildingElementProxy"
        },
        "bsi::ifc::prop::Name": "Lofted block (fixture)",
        "bsi::ifc::prop::TypeName": "Lofted block (fixture)",
        "opo::object": {
          "id": "opo-format.org/examples/loft/twisted-block",
          "name": "Lofted block (fixture)",
          "version": "0.1.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "A block lofted through three rectangular sections, the middle one shifted sideways (proposal 0003).",
          "tags": [
            "loft",
            "proposal 0003"
          ],
          "references": [
            {
              "role": "conformance",
              "name": "Proposal 0003: loft",
              "used": "Fixture for the loft conformance cases."
            }
          ]
        },
        "opo::parameters": [
          {
            "name": "width",
            "type": "length",
            "default": 1.0,
            "label": "Width",
            "group": "Size"
          },
          {
            "name": "depth",
            "type": "length",
            "default": 0.5,
            "label": "Depth",
            "group": "Size"
          },
          {
            "name": "height",
            "type": "length",
            "default": 2.0,
            "label": "Height",
            "group": "Size"
          },
          {
            "name": "shift",
            "type": "length",
            "default": 0.3,
            "label": "Shift of the middle section",
            "group": "Size"
          }
        ],
        "opo::rules": {
          "derived": [
            {
              "name": "sections",
              "expr": "for k in [0, 1, 2] return for c in [[0, 0], [width, 0], [width, depth], [0, depth]] return [c[1] + (if k = 1 then shift else 0), c[2], k * height / 2]",
              "note": "Three closed sections, bottom to top."
            }
          ],
          "checks": []
        },
        "opo::recipe": [
          {
            "id": "body",
            "op": "loft",
            "args": {
              "sections": "sections"
            }
          }
        ],
        "opo::representations": [
          {
            "id": "model.medium",
            "context": "model",
            "lod": "medium",
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "body",
                "material": "\"reinforced_concrete\""
              }
            ]
          }
        ],
        "opo::host": {
