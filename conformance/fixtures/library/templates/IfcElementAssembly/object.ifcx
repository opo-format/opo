  "data": [
    {
      "path": "7fa861d7-f69a-5743-b868-67ceeea24481",
      "attributes": {
        "bsi::ifc::class": {
          "code": "IfcElementAssembly",
          "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcElementAssembly"
        },
        "bsi::ifc::prop::Name": "Element assembly (class template)",
        "bsi::ifc::prop::TypeName": "Element assembly (class template)",
        "opo::object": {
          "id": "opo-format.org/library/templates/IfcElementAssembly",
          "name": "Element assembly (class template)",
          "kind": "class_template",
          "archetype": "assembly",
          "version": "0.1.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "Assembly that nests other OPO objects. The template builds a flat truss (Warren or Pratt) from nested IfcMember class templates.",
          "tags": [
            "IfcElementAssembly",
            "assembly",
            "class template"
          ],
          "references": [
            {
              "role": "IFC parameters",
              "name": "IFC 4.3 ADD2 IfcElementAssembly, IfcElementAssemblyTypeEnum and its property and quantity set templates",
              "license": "buildingSMART",
              "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcElementAssembly",
              "used": "Class, predefined types, property and quantity set names, property names, value types and enumerations (names only)."
            },
            {
              "role": "generator",
              "name": "tools/gen_templates.py",
              "used": "Generated from the `assembly` archetype (spec/objects/archetypes.md)."
            }
          ]
        },
        "opo::parameters": [
          {
            "name": "predefined_type",
            "type": "choice",
            "default": "TRUSS",
            "label": "Predefined type",
            "group": "IFC",
            "options": [
              "ABUTMENT",
              "ACCESSORY_ASSEMBLY",
              "ARCH",
              "BEAM_GRID",
              "BRACED_FRAME",
              "CROSS_BRACING",
              "DECK",
              "DILATATIONPANEL",
              "ENTRANCEWORKS",
              "GIRDER",
              "GRID",
              "MAST",
              "PIER",
              "PYLON",
              "RAIL_MECHANICAL_EQUIPMENT_ASSEMBLY",
              "REINFORCEMENT_UNIT",
              "RIGID_FRAME",
              "SHELTER",
              "SIGNALASSEMBLY",
              "SLAB_FIELD",
              "SUMPBUSTER",
              "SUPPORTINGASSEMBLY",
              "SUSPENSIONASSEMBLY",
              "TRACKPANEL",
              "TRACTION_SWITCHING_ASSEMBLY",
              "TRAFFIC_CALMING_DEVICE",
              "TRUSS",
              "TURNOUTPANEL",
              "USERDEFINED",
              "NOTDEFINED"
            ],
            "description": "IFC 4.3 IfcElementAssemblyTypeEnum. Property sets that apply only to some types follow this choice."
          },
          {
            "name": "object_type",
            "type": "text",
            "default": "",
            "label": "Object type (user-defined)",
            "group": "IFC",
            "visible": "predefined_type = \"USERDEFINED\""
          },
          {
            "name": "span",
            "type": "length",
            "default": 8.0,
            "label": "Span",
            "group": "Truss",
            "limits": {
              "min": 1,
              "max": 100
            }
          },
          {
            "name": "truss_depth",
            "type": "length",
            "default": 1.0,
            "label": "Depth (chord centres)",
            "group": "Truss",
            "limits": {
              "min": 0.2,
              "max": 10
            }
          },
          {
            "name": "panels",
            "type": "integer",
            "default": 8,
            "label": "Panels",
            "group": "Truss",
            "limits": {
              "min": 2,
              "max": 60
            }
          },
          {
            "name": "pattern",
            "type": "choice",
            "default": "warren",
            "label": "Pattern",
            "group": "Truss",
            "options": [
              "warren",
              "pratt"
            ]
          },
          {
            "name": "chord_width",
            "type": "length",
            "default": 0.12,
            "label": "Chord section",
            "group": "Members",
            "limits": {
              "min": 0.02,
              "max": 1
            },
            "description": "Square hollow section, width = depth."
          },
          {
            "name": "chord_wall",
            "type": "length",
            "default": 0.006,
            "label": "Chord wall thickness",
            "group": "Members",
            "limits": {
              "min": 0.002,
              "max": 0.05
            }
          },
          {
            "name": "web_width",
            "type": "length",
            "default": 0.08,
            "label": "Web member section",
            "group": "Members",
            "limits": {
              "min": 0.02,
              "max": 1
            }
          },
          {
            "name": "web_wall",
            "type": "length",
            "default": 0.005,
            "label": "Web wall thickness",
            "group": "Members",
            "limits": {
              "min": 0.002,
              "max": 0.05
            }
          },
          {
            "name": "material",
            "type": "material",
            "default": "steel",
            "label": "Material",
            "group": "Materials",
            "options": "materials"
          },
          {
            "name": "Pset_ElementAssemblyCommon",
            "type": "property_set",
            "default": {},
            "label": "Pset_ElementAssemblyCommon",
            "group": "IFC data",
            "properties": [
              {
                "name": "Reference",
                "measure": "IfcIdentifier"
              },
              {
                "name": "Status",
                "measure": "IfcLabel",
                "enum": [
                  "DEMOLISH",
                  "EXISTING",
                  "NEW",
                  "TEMPORARY",
                  "OTHER",
                  "NOTKNOWN",
                  "UNSET"
                ]
              }
            ],
            "optional": false
          }
        ],
        "opo::slots": [],
        "opo::rules": {
          "derived": [
            {
              "name": "panel",
              "expr": "span / panels"
            },
            {
              "name": "member_object",
              "expr": "\"opo-format.org/library/templates/IfcMember\""
            },
            {
              "name": "chord_values",
              "expr": "{predefined_type: \"CHORD\", profile_kind: \"rect_hollow\", width: chord_width, depth: chord_width, wall_thickness: chord_wall, material: material}"
            },
            {
              "name": "web_values",
              "expr": "{predefined_type: \"MEMBER\", profile_kind: \"rect_hollow\", width: web_width, depth: web_width, wall_thickness: web_wall, material: material}"
            },
            {
              "name": "diagonals",
              "expr": "for k in 1..panels return if pattern = \"warren\" then (if modulo(k, 2) = 1 then [[(k - 1) * panel, 0, 0], [k * panel, 0, truss_depth]] else [[(k - 1) * panel, 0, truss_depth], [k * panel, 0, 0]]) else (if k <= panels / 2 then [[(k - 1) * panel, 0, truss_depth], [k * panel, 0, 0]] else [[(k - 1) * panel, 0, 0], [k * panel, 0, truss_depth]])",
              "note": "Warren: alternating diagonals. Pratt: diagonals slope down towards the middle."
            },
            {
              "name": "verticals",
              "expr": "if pattern = \"pratt\" then for k in 0..panels return [[k * panel, 0, 0], [k * panel, 0, truss_depth]] else []"
            },
            {
              "name": "member_count",
              "expr": "2 + count(diagonals) + count(verticals)"
            }
          ],
          "checks": [
            {
              "id": "panels_even",
              "expr": "pattern != \"warren\" or modulo(panels, 2) = 0",
              "severity": "warning",
              "message": "A Warren truss with an odd number of panels ends on a different chord at each support."
            }
          ],
          "rulesets": []
        },
        "opo::recipe": [
          {
            "id": "top_chord",
            "op": "instance",
            "args": {
              "object": "member_object",
              "values": "chord_values",
              "inputs": "{path: [[0, 0, truss_depth], [span, 0, truss_depth]]}"
            }
          },
          {
            "id": "bottom_chord",
            "op": "instance",
            "args": {
              "object": "member_object",
              "values": "chord_values",
              "inputs": "{path: [[0, 0, 0], [span, 0, 0]]}"
            }
          },
          {
            "id": "web_diagonals",
            "op": "for_each",
            "args": {
              "items": "diagonals",
              "as": "d",
              "index": "i",
              "do": "instance(member_object, web_values, {path: d})"
            }
          },
          {
            "id": "web_verticals",
            "op": "for_each",
            "args": {
              "items": "verticals",
              "as": "d",
              "index": "i",
              "do": "instance(member_object, web_values, {path: d})"
            }
          },
          {
            "id": "plan_line",
            "op": "line",
            "plane": "xy",
            "args": {
              "start": "[0, 0]",
              "end": "[span, 0]"
            }
          },
          {
            "id": "plan_band",
            "op": "rectangle",
            "plane": "xy",
            "args": {
              "min": "[0, -chord_width / 2]",
              "max": "[span, chord_width / 2]"
            }
          }
        ],
        "opo::representations": [
