        "opo::object": {
          "id": "opo-format.org/library/templates/IfcStair",
          "name": "Stair (class template)",
          "kind": "class_template",
          "archetype": "flight",
          "version": "0.1.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "Straight-run stair between two storeys: riser count from the rise and the maximum riser, going, width, concrete waist or solid, plan symbol with cut line and walking line.",
          "tags": [
            "IfcStair",
            "flight",
            "class template"
          ],
          "references": [
            {
              "role": "IFC parameters",
              "name": "IFC 4.3 ADD2 IfcStair, IfcStairTypeEnum and its property and quantity set templates",
              "license": "buildingSMART",
              "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcStair",
              "used": "Class, predefined types, property and quantity set names, property names, value types and enumerations (names only)."
            },
            {
              "role": "generator",
              "name": "tools/gen_templates.py",
              "used": "Generated from the `flight` archetype (spec/objects/archetypes.md)."
            }
          ]
        },
        "opo::parameters": [
          {
