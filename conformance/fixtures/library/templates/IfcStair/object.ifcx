              }
            ],
            "note": "Treads below the cut drawn, above it dashed; break line at the cut; walking line with arrow and label."
          },
          {
            "id": "plan.high",
            "context": "plan",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "outline_below",
                "class": "projected"
              },
              {
