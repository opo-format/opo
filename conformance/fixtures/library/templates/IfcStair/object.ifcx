            "type": "length",
            "default": 3.0,
            "label": "Total rise",
            "group": "Rise",
            "visible": "rise_mode = \"value\"",
            "limits": {
              "min": 0.1,
              "max": 10
            }
          },
          {
            "name": "max_riser",
            "type": "length",
            "default": 0.18,
            "label": "Maximum riser",
            "group": "Steps",
            "limits": {
              "min": 0.05,
              "max": 0.3
            },
            "description": "Generic default (no EN/ISO stair geometry norm); a rule set layer sets regional limits."
          },
          {
