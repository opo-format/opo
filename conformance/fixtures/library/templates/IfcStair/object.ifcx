        "opo::slots": [],
        "opo::rules": {
          "derived": [
            {
              "name": "total_rise",
              "expr": "if rise_mode = \"storey\" then level.height else rise_value"
            },
            {
              "name": "risers",
              "expr": "ceiling(total_rise / max_riser)"
            },
            {
              "name": "riser",
              "expr": "total_rise / risers"
            },
            {
              "name": "treads",
              "expr": "risers - 1"
            },
            {
              "name": "run",
              "expr": "treads * going"
            },
            {
              "name": "pitch",
              "expr": "atan2(riser, going)"
            },
            {
              "name": "step_rule",
              "expr": "2 * riser + going",
              "note": "Shown for information (2R + G); checked only by a rule set."
            },
            {
              "name": "waist_v",
              "expr": "waist_thickness / cos(pitch)",
              "note": "Waist thickness measured vertically."
            },
            {
              "name": "under_x0",
              "expr": "max(0, (waist_v - riser) * going / riser)"
            },
            {
              "name": "under_z0",
              "expr": "max(0, riser - waist_v)"
            },
            {
              "name": "steps",
              "expr": "for j in 1..2 * treads return if modulo(j, 2) = 1 then [(j - 1) / 2 * going, (j + 1) / 2 * riser] else [j / 2 * going, j / 2 * riser]",
              "note": "Nosing and back of each tread (two points per tread)."
            },
            {
              "name": "profile_points",
              "expr": "if structure = \"waist\" then concatenate([[0, 0]], steps, [[run, total_rise], [run, total_rise - waist_v], [under_x0, under_z0]]) else concatenate([[0, 0]], steps, [[run, total_rise], [run, 0]])"
            },
            {
              "name": "x_cut",
              "expr": "min(run, max(0, (view.cut_height - riser) * going / riser))",
              "note": "Where the plan cut height meets the stair."
            },
            {
              "name": "hw",
              "expr": "width / 2"
            }
          ],
          "checks": [
            {
              "id": "min_risers",
              "expr": "risers >= 2",
              "severity": "error",
              "message": "A stair needs at least two risers."
            },
            {
              "id": "riser_range",
              "expr": "rules.stairs = null or (riser >= rules.stairs.riser_min and riser <= rules.stairs.riser_max)",
              "severity": "warning",
              "message": "Riser is outside the active rule set."
            },
            {
              "id": "going_range",
              "expr": "rules.stairs = null or (going >= rules.stairs.going_min and going <= rules.stairs.going_max)",
              "severity": "warning",
              "message": "Going is outside the active rule set."
            },
            {
              "id": "step_rule_range",
              "expr": "rules.stairs = null or rules.stairs.rule_min = null or (step_rule >= rules.stairs.rule_min and step_rule <= rules.stairs.rule_max)",
              "severity": "warning",
              "message": "2R + G is outside the active rule set."
            },
            {
              "id": "width_min",
              "expr": "rules.stairs = null or rules.stairs.width_min = null or width >= rules.stairs.width_min",
              "severity": "warning",
              "message": "Width is below the active rule set."
            },
            {
              "id": "straight_only",
              "expr": "predefined_type = \"STRAIGHT_RUN_STAIR\" or predefined_type = \"USERDEFINED\" or predefined_type = \"NOTDEFINED\"",
              "severity": "warning",
              "message": "This class template draws a straight run; use the library objects (C-02…C-05) for other stair forms."
            }
          ],
          "rulesets": [
            {
              "id": "stairs",
              "default": null,
              "note": "No stair rule set by default (no EN/ISO stair geometry norm). Layers add regional limits (spec/objects/rulesets.md).",
              "fields": {
                "riser_min": "length",
                "riser_max": "length",
                "going_min": "length",
                "going_max": "length",
                "rule_min": "length",
                "rule_max": "length",
                "width_min": "length"
              }
            }
          ]
        },
        "opo::recipe": [
          {
            "id": "profile",
            "op": "polygon",
            "plane": "xz",
            "args": {
              "points": "profile_points"
            }
          },
          {
            "id": "body",
            "op": "extrude",
            "plane": "xz",
            "args": {
              "profile": "profile",
              "from": "-hw",
              "to": "hw"
            }
          },
          {
            "id": "outline_below",
            "op": "rectangle",
            "plane": "xy",
            "args": {
              "min": "[0, -hw]",
              "max": "[x_cut, hw]"
            }
          },
          {
            "id": "outline_above",
            "op": "rectangle",
            "plane": "xy",
            "when": "x_cut < run",
            "args": {
              "min": "[x_cut, -hw]",
              "max": "[run, hw]"
            }
          },
          {
            "id": "treads_below",
            "op": "for_each",
            "plane": "xy",
            "args": {
              "items": "for k in 1..treads return k",
              "as": "k",
              "index": "i",
              "do": "if k * going <= x_cut then line([k * going, -hw], [k * going, hw]) else null"
            }
          },
          {
            "id": "treads_above",
            "op": "for_each",
            "plane": "xy",
            "args": {
              "items": "for k in 1..treads return k",
              "as": "k",
              "index": "i",
              "do": "if k * going > x_cut then line([k * going, -hw], [k * going, hw]) else null"
            }
          },
          {
            "id": "cut_line",
            "op": "polyline",
            "plane": "xy",
            "when": "x_cut < run",
            "args": {
              "points": "[[x_cut - 0.15, -hw], [x_cut - 0.05, -0.1 * width], [x_cut + 0.05, 0.1 * width], [x_cut + 0.15, hw]]"
            }
          },
          {
            "id": "walk_line",
            "op": "polyline",
            "plane": "xy",
            "args": {
              "points": "[[going / 2, 0], [run, 0]]"
            }
          },
          {
            "id": "arrow",
            "op": "polyline",
            "plane": "xy",
            "args": {
              "points": "[[run - 0.15, -0.075], [run, 0], [run - 0.15, 0.075]]"
            }
          },
          {
            "id": "label",
            "op": "text",
            "plane": "xy",
            "args": {
              "at": "[going / 2, -0.12]",
              "value": "arrow_label",
              "height": "0.0025"
            }
          }
        ],
        "opo::representations": [
