            "type": "choice",
            "default": "STRAIGHT_RUN_STAIR",
            "label": "Predefined type",
            "group": "IFC",
            "options": [
              "CURVED_RUN_STAIR",
              "DOUBLE_RETURN_STAIR",
              "HALF_TURN_STAIR",
              "HALF_WINDING_STAIR",
              "LADDER",
