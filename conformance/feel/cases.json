{
 "suite": "feel",
 "spec": "0.1",
 "cases": [
  {
   "id": "arith-precedence",
   "expr": "1 + 2 * 3",
   "expected": 7.0
  },
  {
   "id": "arith-parens",
   "expr": "(1 + 2) * 3",
   "expected": 9.0
  },
  {
   "id": "arith-power",
   "expr": "2 ** 3",
   "expected": 8.0
  },
  {
   "id": "arith-unary-minus",
   "expr": "-(2 - 5)",
   "expected": 3.0
  },
  {
   "id": "arith-div-zero",
   "expr": "1 / 0",
   "expected": null,
   "note": "division by zero gives null"
  },
  {
   "id": "null-arith",
   "expr": "null + 1",
   "expected": null,
   "note": "null propagates"
  },
  {
   "id": "null-compare",
   "expr": "null < 1",
   "expected": null
  },
  {
   "id": "null-equals-null",
   "expr": "null = null",
   "expected": true
  },
  {
   "id": "cmp-float-eq",
   "expr": "0.1 + 0.2 = 0.3",
   "expected": true,
   "note": "numbers within 1e-9 are equal"
  },
  {
   "id": "cmp-float-ne",
   "expr": "0.1 != 0.1000001",
   "expected": true
  },
  {
   "id": "cmp-order-tolerance",
   "expr": "0.3 < 0.3 + 1e-12",
   "expected": false,
   "note": "ordering uses the 1e-9 tolerance of ="
  },
  {
   "id": "cmp-order-tolerance-le",
   "expr": "0.1 + 0.2 <= 0.3",
   "expected": true
  },
  {
   "id": "cmp-string",
   "expr": "\"left\" = \"left\"",
   "expected": true
  },
  {
   "id": "logic-and-null",
   "expr": "false and null",
   "expected": false,
   "note": "three-valued logic"
  },
  {
   "id": "logic-or-null",
   "expr": "true or null",
   "expected": true
  },
  {
   "id": "logic-and-unknown",
   "expr": "true and null",
   "expected": null
  },
  {
   "id": "logic-not",
   "expr": "not(false)",
   "expected": true
  },
  {
   "id": "logic-not-null",
   "expr": "not(null)",
   "expected": null
  },
  {
   "id": "if-true",
   "expr": "if 2 > 1 then \"a\" else \"b\"",
   "expected": "a"
  },
  {
   "id": "if-null-condition",
   "expr": "if null then 1 else 2",
   "expected": 2.0,
   "note": "a null condition takes the else branch"
  },
  {
   "id": "if-nested",
   "expr": "if w >= mm(1200) then 2 else if w >= mm(900) then 1 else 0",
   "context": {
    "w": 0.9
   },
   "expected": 1.0
  },
  {
   "id": "unit-mm",
   "expr": "mm(900)",
   "expected": 0.9
  },
  {
   "id": "unit-cm",
   "expr": "cm(5)",
   "expected": 0.05
  },
  {
   "id": "unit-m",
   "expr": "m(2.5)",
   "expected": 2.5
  },
  {
   "id": "unit-inch",
   "expr": "inch(36)",
   "expected": 0.9144
  },
  {
   "id": "unit-ft",
   "expr": "ft(6) + inch(8)",
   "expected": 2.032
  },
  {
   "id": "unit-deg",
   "expr": "deg(90)",
   "expected": 90.0
  },
  {
   "id": "trig-sin",
   "expr": "sin(30)",
   "expected": 0.5,
   "note": "degrees"
  },
  {
   "id": "trig-cos",
   "expr": "cos(60)",
   "expected": 0.5
  },
  {
   "id": "trig-tan",
   "expr": "tan(45)",
   "expected": 1.0
  },
  {
   "id": "trig-atan2",
   "expr": "atan2(1, 1)",
   "expected": 45.0
  },
  {
   "id": "num-min-args",
   "expr": "min(3, 1, 2)",
   "expected": 1.0
  },
  {
   "id": "num-min-list",
   "expr": "min([3, 1, 2])",
   "expected": 1.0
  },
  {
   "id": "num-max-list",
   "expr": "max([1, 5, 2])",
   "expected": 5.0
  },
  {
   "id": "num-abs",
   "expr": "abs(-0.2)",
   "expected": 0.2
  },
  {
   "id": "num-sqrt",
   "expr": "sqrt(2)",
   "expected": 1.414213562373
  },
  {
   "id": "num-ceiling",
   "expr": "ceiling(2.8 / 0.175)",
   "expected": 16.0,
   "note": "16 exactly: values within 1e-9 of an integer are not rounded up"
  },
  {
   "id": "num-ceiling-frac",
   "expr": "ceiling(2.1)",
   "expected": 3.0
  },
  {
   "id": "num-floor",
   "expr": "floor(-2.5)",
   "expected": -3.0
  },
  {
   "id": "num-round-half-even-1",
   "expr": "round(2.5)",
   "expected": 2.0,
   "note": "half to even"
  },
  {
   "id": "num-round-half-even-2",
   "expr": "round(3.5)",
   "expected": 4.0
  },
  {
   "id": "num-round-scale",
   "expr": "round(1.23456, 2)",
   "expected": 1.23
  },
  {
   "id": "num-round-near-half",
   "expr": "round(2.675, 2)",
   "expected": 2.68,
   "note": "within 1e-9 of a half counts as a half (2.675 is 2.67499... as a double)"
  },
  {
   "id": "num-modulo",
   "expr": "modulo(7, 3)",
   "expected": 1.0
  },
  {
   "id": "num-modulo-negative",
   "expr": "modulo(-7, 3)",
   "expected": 2.0,
   "note": "result has the sign of the divisor"
  },
  {
   "id": "list-literal",
   "expr": "[1, 2, 3]",
   "expected": [1.0, 2.0, 3.0]
  },
  {
   "id": "list-index-first",
   "expr": "[1, 2, 3][1]",
   "expected": 1.0,
   "note": "1-based"
  },
  {
   "id": "list-index-last",
   "expr": "[1, 2, 3][-1]",
   "expected": 3.0,
   "note": "negative counts from the end"
  },
  {
   "id": "list-index-out",
   "expr": "[1, 2, 3][4]",
   "expected": null,
   "note": "out of range gives null"
  },
  {
   "id": "list-index-zero",
   "expr": "[1, 2, 3][0]",
   "expected": null
  },
  {
   "id": "list-sum",
   "expr": "sum([1, 2, 3.5])",
   "expected": 6.5
  },
  {
   "id": "list-sum-empty",
   "expr": "sum([])",
   "expected": null,
   "note": "empty sum is null"
  },
  {
   "id": "list-count",
   "expr": "count([1, 2, 3])",
   "expected": 3.0
  },
  {
   "id": "list-sublist",
   "expr": "sublist([1, 2, 3, 4], 2, 2)",
   "expected": [2.0, 3.0]
  },
  {
   "id": "list-sublist-tail",
   "expr": "sublist([1, 2, 3, 4], 3)",
   "expected": [3.0, 4.0]
  },
  {
   "id": "list-sublist-negative",
   "expr": "sublist([1, 2, 3, 4], -2)",
   "expected": [3.0, 4.0]
  },
  {
   "id": "list-append",
   "expr": "append([1, 2], 3)",
   "expected": [1.0, 2.0, 3.0]
  },
  {
   "id": "list-concatenate",
   "expr": "concatenate([1], [2, 3], [])",
   "expected": [1.0, 2.0, 3.0]
  },
  {
   "id": "list-reverse",
   "expr": "reverse([1, 2, 3])",
   "expected": [3.0, 2.0, 1.0]
  },
  {
   "id": "list-index-of",
   "expr": "index_of([\"a\", \"b\", \"a\"], \"a\")",
   "expected": [1.0, 3.0]
  },
  {
   "id": "list-contains",
   "expr": "list_contains([1, 2], 2)",
   "expected": true
  },
  {
   "id": "list-flatten-deep",
   "expr": "flatten([[1, [2]], [3]])",
   "expected": [1.0, 2.0, 3.0],
   "note": "deep, as in FEEL"
  },
  {
   "id": "for-basic",
   "expr": "for i in 1..3 return i * 2",
   "expected": [2.0, 4.0, 6.0]
  },
  {
   "id": "for-descending",
   "expr": "for i in 3..1 return i",
   "expected": [3.0, 2.0, 1.0],
   "note": "a range runs downwards when the start is larger"
  },
  {
   "id": "for-list",
   "expr": "for x in [0.1, 0.2] return x * 10",
   "expected": [1.0, 2.0]
  },
  {
   "id": "for-nested",
   "expr": "for i in 1..2, j in 1..2 return i * 10 + j",
   "expected": [11.0, 12.0, 21.0, 22.0]
  },
  {
   "id": "for-points",
   "expr": "for j in 1..4 return if modulo(j, 2) = 1 then [(j - 1) / 2, (j + 1) / 2] else [j / 2, j / 2]",
   "expected": [
    [0.0, 1.0],
    [1.0, 1.0],
    [1.0, 2.0],
    [2.0, 2.0]
   ]
  },
  {
   "id": "ctx-literal",
   "expr": "{a: 1, b: \"x\"}",
   "expected": {
    "a": 1.0,
    "b": "x"
   }
  },
  {
   "id": "ctx-access",
   "expr": "{a: 1, b: 2}.b",
   "expected": 2.0
  },
  {
   "id": "ctx-quoted-key",
   "expr": "{\"a b\": 3}",
   "expected": {
    "a b": 3.0
   }
  },
  {
   "id": "ctx-path",
   "expr": "host.thickness",
   "context": {
    "host": {
     "thickness": 0.2
    }
   },
   "expected": 0.2
  },
  {
   "id": "path-on-list",
   "expr": "layers.thickness",
   "context": {
    "layers": [
     {
      "thickness": 0.015
     },
     {
      "thickness": 0.2
     }
    ]
   },
   "expected": [0.015, 0.2],
   "note": "a path on a list maps over it"
  },
  {
   "id": "path-missing",
   "expr": "host.missing",
   "context": {
    "host": {
     "thickness": 0.2
    }
   },
   "expected": null,
   "note": "missing key gives null"
  },
  {
   "id": "layers-total",
   "expr": "sum(layers.thickness)",
   "context": {
    "layers": [
     {
      "thickness": 0.015
     },
     {
      "thickness": 0.2
     },
     {
      "thickness": 0.015
     }
    ]
   },
   "expected": 0.23
  },
  {
   "id": "layers-start",
   "expr": "for i in 1..count(layers) return sum(sublist(layers.thickness, 1, i)) - layers[i].thickness",
   "context": {
    "layers": [
     {
      "thickness": 0.015
     },
     {
      "thickness": 0.2
     },
     {
      "thickness": 0.015
     }
    ]
   },
   "expected": [0.0, 0.015, 0.215],
   "note": "the layer offsets used by walls and slabs"
  },
  {
   "id": "core-index",
   "expr": "if count(index_of(layers.core, true)) > 0 then index_of(layers.core, true)[1] else ceiling(count(layers) / 2)",
   "context": {
    "layers": [
     {
      "thickness": 0.01
     },
     {
      "thickness": 0.2,
      "core": true
     },
     {
      "thickness": 0.01
     }
    ]
   },
   "expected": 2.0
  },
  {
   "id": "polygon-area",
   "expr": "abs(sum(for i in 1..count(p) return p[i][1] * p[modulo(i, count(p)) + 1][2] - p[modulo(i, count(p)) + 1][1] * p[i][2])) / 2",
   "context": {
    "p": [
     [0, 0],
     [6, 0],
     [6, 4],
     [0, 4]
    ]
   },
   "expected": 24.0,
   "note": "shoelace area as used by slabs"
  },
  {
   "id": "string-concat",
   "expr": "\"IPE \" + \"270\"",
   "expected": "IPE 270"
  }
 ]
}
