  "schemas": {},
  "data": [
    {
      "path": "2498acc0-df0f-547b-a8ac-27e7f70b36d8",
      "children": {
        "Lining": "507d5e8e-604d-5c57-845b-19317f8146c6",
        "Stop": "4f9f8227-515d-584c-8d5d-9e97ba934db9",
        "FrontCasing": "c7f48cc4-b7c8-51e0-a580-6a173b6511d0",
        "BackCasing": "7b4f9f8b-8c31-5792-9a9b-ef91e579f32b",
        "Leaf": "cdf1fa76-9823-5bb0-b74a-1b786d33c09c",
        "Handle": "5e3a6a33-55d0-56d0-8d0c-875fdb425c68",
        "Void": "97b26c21-1651-5aa7-a5e3-0e95489fde91",
        "PlanMedium": "686071f2-32c9-5c5f-a822-9e03fc618feb"
      }
    },
    {
      "path": "2498acc0-df0f-547b-a8ac-27e7f70b36d8",
      "attributes": {
        "bsi::ifc::class": {
          "code": "IfcDoor",
          "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcDoor"
        },
        "bsi::ifc::prop::Name": "Single swing door",
        "bsi::ifc::prop::TypeName": "Single swing door 900 × 2100 opening",
        "bsi::ifc::prop::OverallWidth": 0.89,
        "bsi::ifc::prop::OverallHeight": 2.095,
        "bsi::ifc::prop::LiningDepth": 0.115,
        "bsi::ifc::prop::LiningThickness": 0.017,
        "bsi::ifc::prop::CasingThickness": 0.06,
        "bsi::ifc::prop::CasingDepth": 0.01,
        "bsi::ifc::prop::ThresholdThickness": 0,
        "bsi::ifc::prop::PanelDepth": 0.04,
        "bsi::ifc::prop::OperationType": "SINGLE_SWING_LEFT",
        "bsi::ifc::prop::PanelOperation": "SWINGING",
        "bsi::ifc::prop::PanelPosition": "MIDDLE",
        "bsi::ifc::prop::PanelWidth": 1,
        "opo::object": {
          "id": "opo-format.org/examples/door/single-swing-door",
          "name": "Single swing door",
          "version": "0.2.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "Single swing door with frame, rebated or flush leaf, lever handle, three levels of detail and size catalogues for generic metric, UK and US.",
          "tags": [
            "door",
            "single swing",
            "generic"
          ],
          "references": [
            {
              "role": "parametric basis",
              "name": "bim-all-doors (dormakaba)",
              "license": "CC0-1.0",
              "uri": "https://github.com/dormakaba/bim-all-doors",
              "version": "commit 9a174ae (11 Jun 2026), v1.90",
              "used": "Dimension chain with selectable nominal reference (opening, frame outside, leaf, clear passage); frame types; rebate and leaf lap logic; frame system defaults (lining, stop, lap, gaps); default 115 mm wall."
            },
            {
              "role": "IFC parameters",
              "name": "IFC 4.3 Pset_DoorLiningProperties, Pset_DoorPanelProperties",
              "license": "buildingSMART",
              "uri": "https://ifc43-docs.standards.buildingsmart.org/IFC/RELEASE/IFC4x3/HTML/lexical/Pset_DoorLiningProperties.htm",
              "used": "Names and meaning of LiningDepth, LiningThickness, CasingThickness, CasingDepth, ThresholdThickness, ThresholdDepth, PanelDepth."
            },
            {
              "role": "frame variants",
              "name": "OSArch door/window generator discussion (Door Frame Set)",
              "license": "CC-BY-4.0",
              "uri": "https://community.osarch.org/discussion/comment/24127/",
              "used": "Hollow metal and lining-with-stop frame types."
            },
            {
              "role": "sizes",
              "name": "Generic metric openings (no EU door size norm exists)",
              "used": "Openings 700-1100 x 2100 mm, default 900 x 2100. Not a norm."
            },
            {
              "role": "sizes",
              "name": "BS 4787 (UK metric) and UK imperial door sizes",
              "used": "Leaf sizes 2040 × 526…926 (40 mm) and 1981 × 610…838 (35 mm)."
            },
            {
              "role": "sizes",
              "name": "US industry standard door sizes",
              "used": "Leaf 24, 28, 30, 32, 36 in × 80 in; rough opening = leaf + 2 in × + 2½ in."
            },
            {
              "role": "rules",
              "name": "ISO 21542:2021 (EU: EN 17210 functional requirements), ADA 2010 Standards §404",
              "used": "Accessibility rule set layers."
            }
          ]
        },
        "opo::parameters": [
          {
            "name": "nominal_reference",
            "type": "choice",
            "default": "opening",
            "label": "Nominal size refers to",
            "group": "Size",
            "options": [
              "opening",
              "frame_outside",
              "leaf",
              "clear_passage"
            ],
            "option_labels": {
              "opening": "Wall opening",
              "frame_outside": "Frame outside",
              "leaf": "Door leaf",
              "clear_passage": "Clear passage (frame)"
            },
            "description": "Which measure the nominal width/height describe. UK and US sizes name the leaf."
          },
          {
            "name": "nominal_width",
            "type": "length",
            "default": 0.9,
            "label": "Nominal width",
            "group": "Size",
            "limits": {
              "min": 0.4,
              "max": 1.4,
              "step": {
                "metric": 0.005,
                "imperial": 0.0127
              }
            }
          },
          {
            "name": "nominal_height",
            "type": "length",
            "default": 2.1,
            "label": "Nominal height",
            "group": "Size",
            "limits": {
              "min": 1.8,
              "max": 3.0,
              "step": {
                "metric": 0.005,
                "imperial": 0.0127
              }
            }
          },
          {
            "name": "frame_type",
            "type": "choice",
            "default": "wrap_around",
            "label": "Frame type",
            "group": "Frame",
            "options": [
              "wrap_around",
              "block",
              "lining",
              "hollow_metal"
            ],
            "option_labels": {
              "wrap_around": "Wrap-around frame (Umfassungszarge)",
              "block": "Block frame (Blockzarge)",
              "lining": "Lining with applied stop and architraves",
              "hollow_metal": "Hollow metal frame"
            }
          },
          {
            "name": "block_depth",
            "type": "length",
            "default": 0.1,
            "label": "Block frame depth",
            "group": "Frame",
            "visible": "frame_type = \"block\"",
            "limits": {
              "min": 0.04,
              "max": 0.3
            }
          },
          {
            "name": "lining_thickness",
            "type": "length",
            "default": 0.017,
            "label": "Lining thickness",
            "group": "Frame",
            "limits": {
              "min": 0.01,
              "max": 0.1
            },
            "description": "Frame member width in the plane of the leaf, opening side (IFC LiningThickness)."
          },
          {
            "name": "casing_width",
            "type": "length",
            "default": 0.06,
            "label": "Casing / architrave width",
            "group": "Frame",
            "visible": "frame_type != \"block\"",
            "limits": {
              "min": 0.0,
              "max": 0.15
            },
            "description": "IFC CasingThickness (dimension in the plane of the leaf)."
          },
          {
            "name": "casing_depth",
            "type": "length",
            "default": 0.01,
            "label": "Casing / architrave depth",
            "group": "Frame",
            "visible": "frame_type != \"block\"",
            "limits": {
              "min": 0.0,
              "max": 0.03
            },
            "description": "IFC CasingDepth (dimension perpendicular to the leaf)."
          },
          {
            "name": "stop_width",
            "type": "length",
            "default": 0.015,
            "label": "Stop / rebate width",
            "group": "Frame",
            "limits": {
              "min": 0.0,
              "max": 0.03
            },
            "description": "How far the stop projects into the opening, per side: frame rebate minus clear passage."
          },
          {
            "name": "stop_depth",
            "type": "length",
            "default": 0.038,
            "label": "Applied stop depth",
            "group": "Frame",
            "visible": "frame_type = \"lining\"",
            "limits": {
              "min": 0.01,
              "max": 0.06
            }
          },
          {
            "name": "fit_gap",
            "type": "length",
            "default": 0.005,
            "label": "Fitting gap, sides",
            "group": "Frame system",
            "limits": {
              "min": 0.0,
              "max": 0.03
            },
            "description": "Wall opening to frame outside, per side."
          },
          {
            "name": "fit_gap_top",
            "type": "length",
            "default": 0.005,
            "label": "Fitting gap, top",
            "group": "Frame system",
            "limits": {
              "min": 0.0,
              "max": 0.05
            }
          },
          {
            "name": "leaf_type",
            "type": "choice",
            "default": "rebated",
            "label": "Leaf edge",
            "group": "Leaf",
            "options": [
              "rebated",
              "flush"
            ],
            "option_labels": {
              "rebated": "Rebated (gefälzt)",
              "flush": "Flush (stumpf)"
            }
          },
          {
            "name": "leaf_thickness",
            "type": "length",
            "default": 0.04,
            "label": "Leaf thickness",
            "group": "Leaf",
            "limits": {
              "min": 0.025,
              "max": 0.08,
              "step": {
                "metric": 0.001,
                "imperial": 0.0015875
              }
            },
            "description": "IFC PanelDepth."
          },
          {
            "name": "leaf_lap",
            "type": "length",
            "default": 0.0095,
            "label": "Leaf lap, sides",
            "group": "Leaf",
            "visible": "leaf_type = \"rebated\"",
            "limits": {
              "min": 0.0,
              "max": 0.02
            },
            "description": "How far a rebated leaf overlaps the frame rebate at each side."
          },
          {
            "name": "leaf_lap_top",
            "type": "length",
            "default": 0.009,
            "label": "Leaf lap, top",
            "group": "Leaf",
            "visible": "leaf_type = \"rebated\"",
            "limits": {
              "min": 0.0,
              "max": 0.02
            }
          },
          {
            "name": "leaf_lap_thickness",
            "type": "length",
            "default": 0.013,
            "label": "Leaf lap thickness",
            "group": "Leaf",
            "visible": "leaf_type = \"rebated\"",
            "limits": {
              "min": 0.005,
              "max": 0.03
            }
          },
          {
            "name": "leaf_gap",
            "type": "length",
            "default": 0.003,
            "label": "Leaf gap to frame",
            "group": "Leaf",
            "limits": {
              "min": 0.0,
              "max": 0.01
            }
          },
          {
            "name": "floor_gap",
            "type": "length",
            "default": 0.007,
            "label": "Gap under leaf",
            "group": "Leaf",
            "limits": {
              "min": 0.0,
              "max": 0.03
            }
          },
          {
            "name": "threshold",
            "type": "boolean",
            "default": false,
            "label": "Threshold",
            "group": "Threshold"
          },
          {
            "name": "threshold_thickness",
            "type": "length",
            "default": 0.015,
            "label": "Threshold thickness",
            "group": "Threshold",
            "visible": "threshold",
            "limits": {
              "min": 0.003,
              "max": 0.05
            },
            "description": "IFC ThresholdThickness."
          },
          {
            "name": "handle_height",
            "type": "length",
            "default": 1.0,
            "label": "Handle height",
            "group": "Hardware",
            "limits": {
              "min": 0.8,
              "max": 1.25,
              "step": {
                "metric": 0.005,
                "imperial": 0.0127
              }
            },
            "description": "Finished floor to centre of the lever."
          },
          {
            "name": "backset",
            "type": "length",
            "default": 0.055,
            "label": "Backset",
            "group": "Hardware",
            "limits": {
              "min": 0.04,
              "max": 0.1
            },
            "description": "Leaf edge (lock side) to centre of the handle."
          },
          {
            "name": "key_rose",
            "type": "boolean",
            "default": true,
            "label": "Key rose below handle",
            "group": "Hardware"
          },
          {
            "name": "key_distance",
            "type": "length",
            "default": 0.072,
            "label": "Handle to key distance",
            "group": "Hardware",
            "visible": "key_rose",
            "limits": {
              "min": 0.05,
              "max": 0.1
            }
          },
          {
            "name": "opening_angle",
            "type": "angle",
            "default": 90.0,
            "label": "Plan opening angle",
            "group": "Drawing",
            "limits": {
              "min": 30.0,
              "max": 180.0,
              "step": {
                "metric": 15.0,
                "imperial": 15.0
              }
            }
          },
          {
            "name": "frame_material",
            "type": "material",
            "default": "painted_timber",
            "label": "Frame material",
            "group": "Materials",
            "options": "materials"
          },
          {
            "name": "leaf_material",
            "type": "material",
            "default": "painted_timber",
            "label": "Leaf material",
            "group": "Materials",
            "options": "materials"
          },
          {
            "name": "hardware_material",
            "type": "material",
            "default": "stainless_steel",
            "label": "Hardware material",
            "group": "Materials",
            "options": "materials"
          }
        ],
        "opo::slots": [],
        "opo::rules": {
          "derived": [
            {
              "name": "bottom_gap",
              "expr": "floor_gap + (if threshold then threshold_thickness else 0)",
              "note": "Finished floor to underside of leaf."
            },
            {
              "name": "opening_width",
              "expr": "if nominal_reference = \"opening\" then nominal_width else if nominal_reference = \"frame_outside\" then nominal_width + 2 * fit_gap else if nominal_reference = \"leaf\" then (if leaf_type = \"rebated\" then nominal_width - 2 * leaf_lap else nominal_width + 2 * leaf_gap) + 2 * lining_thickness + 2 * fit_gap else nominal_width + 2 * stop_width + 2 * lining_thickness + 2 * fit_gap"
            },
            {
              "name": "opening_height",
              "expr": "if nominal_reference = \"opening\" then nominal_height else if nominal_reference = \"frame_outside\" then nominal_height + fit_gap_top else if nominal_reference = \"leaf\" then (if leaf_type = \"rebated\" then nominal_height - leaf_lap_top + bottom_gap else nominal_height + leaf_gap + bottom_gap) + lining_thickness + fit_gap_top else nominal_height + stop_width + lining_thickness + fit_gap_top"
            },
            {
              "name": "frame_width",
              "expr": "opening_width - 2 * fit_gap"
            },
            {
              "name": "frame_height",
              "expr": "opening_height - fit_gap_top"
            },
            {
              "name": "rebate_width",
              "expr": "frame_width - 2 * lining_thickness"
            },
            {
              "name": "rebate_height",
              "expr": "frame_height - lining_thickness"
            },
            {
              "name": "clear_width",
              "expr": "rebate_width - 2 * stop_width",
              "note": "Clear passage of the frame, door closed."
            },
            {
              "name": "clear_height",
              "expr": "rebate_height - stop_width"
            },
            {
              "name": "leaf_width",
              "expr": "if leaf_type = \"rebated\" then rebate_width + 2 * leaf_lap else rebate_width - 2 * leaf_gap"
            },
            {
              "name": "leaf_height",
              "expr": "if leaf_type = \"rebated\" then rebate_height + leaf_lap_top - bottom_gap else rebate_height - leaf_gap - bottom_gap"
            },
            {
              "name": "usable_clear_width",
              "expr": "clear_width - leaf_thickness",
              "note": "Clear width with the leaf open at 90°: the open leaf takes its thickness off the hinge side."
            },
            {
              "name": "lining_depth",
              "expr": "if frame_type = \"block\" then block_depth else host.thickness",
              "note": "IFC LiningDepth; wrap-around, lining and hollow metal frames span the wall."
            },
            {
              "name": "has_casing",
              "expr": "frame_type != \"block\""
            },
            {
              "name": "casing_d",
              "expr": "if has_casing then casing_depth else 0"
            },
            {
              "name": "frame_front",
              "expr": "lining_depth / 2",
              "note": "Swing-side face of the lining (y)."
            },
            {
              "name": "leaf_front",
              "expr": "if leaf_type = \"rebated\" then frame_front + leaf_lap_thickness else frame_front"
            },
            {
              "name": "leaf_back",
              "expr": "leaf_front - leaf_thickness"
            },
            {
              "name": "stop_back",
              "expr": "if frame_type = \"lining\" then leaf_back - stop_depth else -lining_depth / 2"
            },
            {
              "name": "front_casing_inset",
              "expr": "if leaf_type = \"rebated\" then leaf_lap + mm(2) else 0",
              "note": "Front casing steps back so the rebated leaf lap sits beside it."
            },
            {
              "name": "hinge",
              "expr": "[-leaf_width / 2, leaf_front]"
            },
            {
              "name": "leaf_tip",
              "expr": "[hinge[1] + leaf_width * cos(opening_angle), hinge[2] + leaf_width * sin(opening_angle)]"
            },
            {
              "name": "handle_x",
              "expr": "leaf_width / 2 - backset"
            },
            {
              "name": "hinge_count",
              "expr": "if leaf_height > mm(2300) then 3 else 2"
            },
            {
              "name": "hinge_z",
              "expr": "[bottom_gap + mm(250), bottom_gap + leaf_height - mm(250), bottom_gap + leaf_height / 2]",
              "note": "Typical hinge positions (250 mm from leaf ends, third hinge centred). Not a norm value."
            }
          ],
          "checks": [
            {
              "id": "leaf_min",
              "expr": "leaf_width >= mm(400)",
              "severity": "error",
              "message": "Door leaf is narrower than 400 mm."
            },
            {
              "id": "single_leaf_max",
              "expr": "leaf_width <= mm(1250)",
              "severity": "warning",
              "message": "Leaf wider than 1250 mm: consider a double door."
            },
            {
              "id": "leaf_fits_frame",
              "expr": "leaf_thickness + (if frame_type = \"lining\" then stop_depth else mm(5)) <= lining_depth",
              "severity": "error",
              "message": "Leaf and stop do not fit in the frame depth."
            },
            {
              "id": "handle_on_leaf",
              "expr": "handle_height + mm(30) < bottom_gap + leaf_height and backset < leaf_width / 2",
              "severity": "error",
              "message": "Handle lies outside the leaf."
            },
            {
              "id": "clear_width",
              "expr": "rules.accessibility = null or (if rules.accessibility.measure = \"clear_passage\" then clear_width else usable_clear_width) >= rules.accessibility.min_clear_width",
              "severity": "warning",
              "message": "Clear width is below the accessibility minimum of the active rule set."
            },
            {
              "id": "handle_range",
              "expr": "rules.accessibility = null or rules.accessibility.handle_min = null or (handle_height >= rules.accessibility.handle_min and handle_height <= rules.accessibility.handle_max)",
              "severity": "warning",
              "message": "Handle height is outside the range of the active accessibility rule set."
            }
          ],
          "rulesets": [
            {
              "id": "accessibility",
              "default": null,
              "note": "No accessibility requirement by default. Layers activate one, e.g. layers/ruleset-iso-21542.ifcx or layers/ruleset-us-ada.ifcx.",
              "fields": {
                "min_clear_width": "length",
                "measure": "choice: clear_passage | usable_clear_width",
                "handle_min": "length",
                "handle_max": "length"
              }
            }
          ]
        },
        "opo::recipe": [
          {
            "id": "opening",
            "op": "rectangle",
            "plane": "xz",
            "args": {
              "min": "[-opening_width / 2, 0]",
              "max": "[opening_width / 2, opening_height]"
            }
          },
          {
            "id": "frame_outline",
            "op": "rectangle",
            "plane": "xz",
            "args": {
              "min": "[-frame_width / 2, 0]",
              "max": "[frame_width / 2, frame_height]"
            }
          },
          {
            "id": "rebate_outline",
            "op": "rectangle",
            "plane": "xz",
            "args": {
              "min": "[-rebate_width / 2, -mm(1)]",
              "max": "[rebate_width / 2, rebate_height]"
            }
          },
          {
            "id": "clear_outline",
            "op": "rectangle",
            "plane": "xz",
            "args": {
              "min": "[-clear_width / 2, -mm(1)]",
              "max": "[clear_width / 2, clear_height]"
            }
          },
          {
            "id": "casing_outline",
            "op": "rectangle",
            "plane": "xz",
            "when": "has_casing",
            "args": {
              "min": "[-frame_width / 2 - casing_width, 0]",
              "max": "[frame_width / 2 + casing_width, frame_height + casing_width]"
            }
          },
          {
            "id": "front_casing_hole",
            "op": "rectangle",
            "plane": "xz",
            "when": "has_casing",
            "args": {
              "min": "[-rebate_width / 2 - front_casing_inset, -mm(1)]",
              "max": "[rebate_width / 2 + front_casing_inset, rebate_height + front_casing_inset]"
            }
          },
          {
            "id": "leaf_outline",
            "op": "rectangle",
            "plane": "xz",
            "args": {
              "min": "[-leaf_width / 2, bottom_gap]",
              "max": "[leaf_width / 2, bottom_gap + leaf_height]"
            }
          },
          {
            "id": "leaf_core_outline",
            "op": "rectangle",
            "plane": "xz",
            "when": "leaf_type = \"rebated\"",
            "args": {
              "min": "[-rebate_width / 2 + leaf_gap, bottom_gap]",
              "max": "[rebate_width / 2 - leaf_gap, rebate_height - leaf_gap]"
            }
          },
          {
            "id": "lining_profile",
            "op": "difference",
            "args": {
              "a": "frame_outline",
              "b": "rebate_outline"
            }
          },
          {
            "id": "lining",
            "op": "extrude",
            "args": {
              "profile": "lining_profile",
              "from": "-lining_depth / 2",
              "to": "lining_depth / 2"
            }
          },
          {
            "id": "stop_profile",
            "op": "difference",
            "args": {
              "a": "rebate_outline",
              "b": "clear_outline"
            }
          },
          {
            "id": "stop",
            "op": "extrude",
            "args": {
              "profile": "stop_profile",
              "from": "stop_back",
              "to": "leaf_back"
            }
          },
          {
            "id": "front_casing",
            "op": "extrude",
            "when": "has_casing",
            "args": {
              "profile": "difference(casing_outline, front_casing_hole)",
              "from": "frame_front",
              "to": "frame_front + casing_d"
            }
          },
          {
            "id": "back_casing",
            "op": "extrude",
            "when": "has_casing",
            "args": {
              "profile": "difference(casing_outline, rebate_outline)",
              "from": "-frame_front - casing_d",
              "to": "-frame_front"
            }
          },
          {
            "id": "threshold_body",
            "op": "extrude",
            "plane": "xz",
            "when": "threshold",
            "args": {
              "profile": "rectangle([-rebate_width / 2, 0], [rebate_width / 2, threshold_thickness])",
              "from": "-lining_depth / 2",
              "to": "lining_depth / 2"
            }
          },
          {
            "id": "leaf_flush",
            "op": "extrude",
            "when": "leaf_type = \"flush\"",
            "args": {
              "profile": "leaf_outline",
              "from": "leaf_back",
              "to": "leaf_front"
            }
          },
          {
            "id": "leaf_lap_part",
            "op": "extrude",
            "when": "leaf_type = \"rebated\"",
            "args": {
              "profile": "leaf_outline",
              "from": "leaf_front - leaf_lap_thickness",
              "to": "leaf_front"
            }
          },
          {
            "id": "leaf_core",
            "op": "extrude",
            "when": "leaf_type = \"rebated\"",
            "args": {
              "profile": "leaf_core_outline",
              "from": "leaf_back",
              "to": "leaf_front - leaf_lap_thickness"
            }
          },
          {
            "id": "leaf",
            "op": "union",
            "args": {
              "items": "[leaf_flush, leaf_lap_part, leaf_core]"
            },
            "note": "Union skips steps whose 'when' is false."
          },
          {
            "id": "panel_low",
            "op": "extrude",
            "args": {
              "profile": "frame_outline",
              "from": "leaf_back",
              "to": "leaf_front"
            }
          },
          {
            "id": "rose_front",
            "op": "extrude",
            "plane": "xz",
            "args": {
              "profile": "circle([handle_x, handle_height], mm(26))",
              "from": "leaf_front",
              "to": "leaf_front + mm(8)"
            }
          },
          {
            "id": "neck_front",
            "op": "extrude",
            "plane": "xz",
            "args": {
              "profile": "circle([handle_x, handle_height], mm(9.5))",
              "from": "leaf_front + mm(8)",
              "to": "leaf_front + mm(55)"
            }
          },
          {
            "id": "lever_front",
            "op": "extrude",
            "plane": "yz",
            "args": {
              "profile": "circle([leaf_front + mm(45.5), handle_height], mm(9.5))",
              "from": "handle_x - mm(130)",
              "to": "handle_x + mm(9.5)"
            }
          },
          {
            "id": "rose_back",
            "op": "extrude",
            "plane": "xz",
            "args": {
              "profile": "circle([handle_x, handle_height], mm(26))",
              "from": "leaf_back - mm(8)",
              "to": "leaf_back"
            }
          },
          {
            "id": "neck_back",
            "op": "extrude",
            "plane": "xz",
            "args": {
              "profile": "circle([handle_x, handle_height], mm(9.5))",
              "from": "leaf_back - mm(55)",
              "to": "leaf_back - mm(8)"
            }
          },
          {
            "id": "lever_back",
            "op": "extrude",
            "plane": "yz",
            "args": {
              "profile": "circle([leaf_back - mm(45.5), handle_height], mm(9.5))",
              "from": "handle_x - mm(130)",
              "to": "handle_x + mm(9.5)"
            }
          },
          {
            "id": "key_rose_front",
            "op": "extrude",
            "plane": "xz",
            "when": "key_rose",
            "args": {
              "profile": "circle([handle_x, handle_height - key_distance], mm(20))",
              "from": "leaf_front",
              "to": "leaf_front + mm(8)"
            }
          },
          {
            "id": "key_rose_back",
            "op": "extrude",
            "plane": "xz",
            "when": "key_rose",
            "args": {
              "profile": "circle([handle_x, handle_height - key_distance], mm(20))",
              "from": "leaf_back - mm(8)",
              "to": "leaf_back"
            }
          },
          {
            "id": "handle",
            "op": "union",
            "args": {
              "items": "[rose_front, neck_front, lever_front, rose_back, neck_back, lever_back, key_rose_front, key_rose_back]"
            }
          },
          {
            "id": "lever_simple_profile",
            "op": "rectangle",
            "plane": "xz",
            "args": {
              "min": "[handle_x - mm(130), handle_height - mm(10)]",
              "max": "[handle_x + mm(10), handle_height + mm(10)]"
            }
          },
          {
            "id": "handle_simple",
            "op": "union",
            "args": {
              "items": "[extrude(lever_simple_profile, leaf_front, leaf_front + mm(55)), extrude(lever_simple_profile, leaf_back - mm(55), leaf_back)]"
            }
          },
          {
            "id": "hinge_knuckle",
            "op": "circle",
            "plane": "xy",
            "args": {
              "center": "hinge",
              "radius": "mm(7)"
            }
          },
          {
            "id": "hinges",
            "op": "union",
            "args": {
              "items": "[extrude(hinge_knuckle, hinge_z[1] - mm(50), hinge_z[1] + mm(50)), extrude(hinge_knuckle, hinge_z[2] - mm(50), hinge_z[2] + mm(50)), if hinge_count = 3 then extrude(hinge_knuckle, hinge_z[3] - mm(50), hinge_z[3] + mm(50)) else null]"
            }
          },
          {
            "id": "void",
            "op": "extrude",
            "args": {
              "profile": "opening",
              "from": "-host.thickness / 2 - mm(10)",
              "to": "host.thickness / 2 + mm(10)"
            }
          },
          {
            "id": "jamb_left_plan",
            "op": "union",
            "plane": "xy",
            "args": {
              "items": "[rectangle([-frame_width / 2, -lining_depth / 2], [-rebate_width / 2, lining_depth / 2]), rectangle([-rebate_width / 2, stop_back], [-clear_width / 2, leaf_back]), if has_casing then rectangle([-frame_width / 2 - casing_width, frame_front], [-rebate_width / 2 - front_casing_inset, frame_front + casing_d]) else null, if has_casing then rectangle([-frame_width / 2 - casing_width, -frame_front - casing_d], [-rebate_width / 2, -frame_front]) else null]"
            }
          },
          {
            "id": "jamb_right_plan",
            "op": "mirror",
            "args": {
              "geometry": "jamb_left_plan",
              "axis": "\"x\""
            }
          },
          {
            "id": "leaf_closed_plan",
            "op": "rectangle",
            "plane": "xy",
            "args": {
              "min": "[-leaf_width / 2, leaf_back]",
              "max": "[leaf_width / 2, leaf_front]"
            }
          },
          {
            "id": "leaf_open_plan",
            "op": "rotate",
            "args": {
              "geometry": "leaf_closed_plan",
              "center": "hinge",
              "angle": "opening_angle"
            }
          },
          {
            "id": "leaf_line_plan",
            "op": "line",
            "plane": "xy",
            "args": {
              "start": "hinge",
              "end": "leaf_tip"
            }
          },
          {
            "id": "swing_arc_plan",
            "op": "arc",
            "plane": "xy",
            "args": {
              "center": "hinge",
              "radius": "leaf_width",
              "start_angle": "0",
              "end_angle": "opening_angle"
            }
          },
          {
            "id": "swing_indicator",
            "op": "polyline",
            "plane": "xz",
            "args": {
              "points": "[[leaf_width / 2, bottom_gap], [-leaf_width / 2, bottom_gap + leaf_height / 2], [leaf_width / 2, bottom_gap + leaf_height]]"
            }
          }
        ],
