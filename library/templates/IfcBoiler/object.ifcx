  "data": [
    {
      "path": "47380cc6-e00f-577a-9c3a-7bbceaa200b0",
      "attributes": {
        "bsi::ifc::class": {
          "code": "IfcBoiler",
          "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcBoiler"
        },
        "bsi::ifc::prop::Name": "Boiler (class template)",
        "bsi::ifc::prop::TypeName": "Boiler (class template)",
        "opo::object": {
          "id": "opo-format.org/library/templates/IfcBoiler",
          "name": "Boiler (class template)",
          "kind": "class_template",
          "archetype": "point",
          "version": "0.1.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "Boiler as a cased body with its pipe and flue connections, wall-hung or floor-standing, with a service clearance zone.",
          "tags": [
            "IfcBoiler",
            "point",
            "class template"
          ],
          "references": [
            {
              "role": "IFC parameters",
              "name": "IFC 4.3 ADD2 IfcBoiler, IfcBoilerTypeEnum and its property and quantity set templates",
              "license": "buildingSMART",
              "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcBoiler",
              "used": "Class, predefined types, property and quantity set names, property names, value types and enumerations (names only)."
            },
            {
              "role": "generator",
              "name": "tools/gen_templates.py",
              "used": "Generated from the `point` archetype (spec/objects/archetypes.md)."
            }
          ]
        },
        "opo::parameters": [
          {
            "name": "predefined_type",
            "type": "choice",
            "default": "WATER",
            "label": "Predefined type",
            "group": "IFC",
            "options": [
              "STEAM",
              "WATER",
              "USERDEFINED",
              "NOTDEFINED"
            ],
            "description": "IFC 4.3 IfcBoilerTypeEnum. Property sets that apply only to some types follow this choice."
          },
          {
            "name": "object_type",
            "type": "text",
            "default": "",
            "label": "Object type (user-defined)",
            "group": "IFC",
            "visible": "predefined_type = \"USERDEFINED\""
          },
          {
            "name": "mount",
            "type": "choice",
            "default": "wall",
            "label": "Mounting",
            "group": "Placement",
            "options": [
              "wall",
              "floor"
            ]
          },
          {
            "name": "width",
            "type": "length",
            "default": 0.45,
            "label": "Width",
            "group": "Size",
            "limits": {
              "min": 0.1,
              "max": 5
            },
            "description": "Typical wall-hung size; replace with maker data."
          },
          {
            "name": "depth",
            "type": "length",
            "default": 0.35,
            "label": "Depth",
            "group": "Size",
            "limits": {
              "min": 0.1,
              "max": 5
            }
          },
          {
            "name": "height",
            "type": "length",
            "default": 0.75,
            "label": "Height",
            "group": "Size",
            "limits": {
              "min": 0.1,
              "max": 5
            }
          },
          {
            "name": "mount_height",
            "type": "length",
            "default": 1.2,
            "label": "Underside above floor",
            "group": "Placement",
            "visible": "mount = \"wall\"",
            "limits": {
              "min": 0,
              "max": 5
            }
          },
          {
            "name": "clearance_front",
            "type": "length",
            "default": 0.6,
            "label": "Service clearance, front",
            "group": "Clearance",
            "limits": {
              "min": 0,
              "max": 3
            },
            "description": "Project or maker value."
          },
          {
            "name": "clearance_side",
            "type": "length",
            "default": 0.05,
            "label": "Service clearance, sides",
            "group": "Clearance",
            "limits": {
              "min": 0,
              "max": 1
            }
          },
          {
            "name": "pipe_size",
            "type": "length",
            "default": 0.022,
            "label": "Water connection outside diameter",
            "group": "Connections",
            "limits": {
              "min": 0.008,
              "max": 0.3
            }
          },
          {
            "name": "gas_size",
            "type": "length",
            "default": 0.015,
            "label": "Gas connection outside diameter",
            "group": "Connections",
            "limits": {
              "min": 0.008,
              "max": 0.2
            }
          },
          {
            "name": "flue_size",
            "type": "length",
            "default": 0.1,
            "label": "Flue diameter",
            "group": "Connections",
            "limits": {
              "min": 0.04,
              "max": 0.6
            }
          },
          {
            "name": "symbol_code",
            "type": "text",
            "default": "BLR",
            "label": "Plan symbol code",
            "group": "Drawing"
          },
          {
            "name": "casing_material",
            "type": "material",
            "default": "sheet_metal",
            "label": "Casing",
            "group": "Materials",
            "options": "materials"
          },
          {
            "name": "Pset_BoilerPHistory",
            "type": "property_set",
            "default": {},
            "label": "Pset_BoilerPHistory",
            "group": "IFC data",
            "properties": [
              {
                "name": "EnergySourceConsumption",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "OperationalEfficiency",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "CombustionEfficiency",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "WorkingPressureHistory",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "CombustionChamberTemperature",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "PartLoadRatio",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "Load",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "PrimaryEnergyConsumption",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "AuxiliaryEnergyConsumption",
                "measure": "IfcTimeSeries"
              }
            ],
            "optional": false
          },
          {
            "name": "Pset_BoilerTypeCommon",
            "type": "property_set",
            "default": {},
            "label": "Pset_BoilerTypeCommon",
            "group": "IFC data",
            "properties": [
              {
                "name": "Reference",
                "measure": "IfcIdentifier"
              },
              {
                "name": "Status",
                "measure": "IfcLabel",
                "enum": [
                  "DEMOLISH",
                  "EXISTING",
                  "NEW",
                  "TEMPORARY",
                  "OTHER",
                  "NOTKNOWN",
                  "UNSET"
                ]
              },
              {
                "name": "PressureRating",
                "measure": "IfcPressureMeasure"
              },
              {
                "name": "OperatingMode",
                "measure": "IfcLabel",
                "enum": [
                  "FIXED",
                  "MODULATING",
                  "TWOSTEP",
                  "OTHER",
                  "NOTKNOWN",
                  "UNSET"
                ]
              },
              {
                "name": "HeatTransferSurfaceArea",
                "measure": "IfcAreaMeasure"
              },
              {
                "name": "NominalPartLoadRatio",
                "measure": "IfcReal"
              },
              {
                "name": "WaterInletTemperatureRange",
                "measure": "IfcThermodynamicTemperatureMeasure"
              },
              {
                "name": "WaterStorageCapacity",
                "measure": "IfcVolumeMeasure"
              },
              {
                "name": "IsWaterStorageHeater",
                "measure": "IfcBoolean"
              },
              {
                "name": "PartialLoadEfficiencyCurves",
                "measure": "IfcPositiveRatioMeasure"
              },
              {
                "name": "OutletTemperatureRange",
                "measure": "IfcThermodynamicTemperatureMeasure"
              },
              {
                "name": "NominalEnergyConsumption",
                "measure": "IfcPowerMeasure"
              },
              {
                "name": "EnergySource",
                "measure": "IfcLabel",
                "enum": [
                  "COAL",
                  "COAL_PULVERIZED",
                  "ELECTRICITY",
                  "GAS",
                  "OIL",
                  "PROPANE",
                  "WOOD",
                  "WOOD_CHIP",
                  "WOOD_PELLET",
                  "WOOD_PULVERIZED",
                  "OTHER",
                  "NOTKNOWN",
                  "UNSET"
                ]
              }
            ],
            "optional": false
          }
        ],
        "opo::slots": [],
        "opo::rules": {
          "derived": [
            {
              "name": "bottom",
              "expr": "if mount = \"wall\" then mount_height else 0"
            },
            {
              "name": "top",
              "expr": "bottom + height"
            },
            {
              "name": "port_x",
              "expr": "[-width / 2 + 0.07, -width / 2 + 0.15, width / 2 - 0.15]",
              "note": "Pipe connections along the underside (flow, return, gas). Typical layout."
            }
          ],
          "checks": [
            {
              "id": "ports_fit",
              "expr": "width >= 0.3",
              "severity": "warning",
              "message": "The body is narrower than the default connection layout; set port positions from maker data."
            }
          ],
          "rulesets": []
        },
        "opo::recipe": [
          {
            "id": "body",
            "op": "box",
            "args": {
              "min": "[-width / 2, 0, bottom]",
              "max": "[width / 2, depth, top]"
            }
          },
          {
            "id": "stubs",
            "op": "union",
            "args": {
              "items": "[cylinder([port_x[1], depth / 2, bottom], [port_x[1], depth / 2, bottom - 0.05], pipe_size / 2), cylinder([port_x[2], depth / 2, bottom], [port_x[2], depth / 2, bottom - 0.05], pipe_size / 2), cylinder([port_x[3], depth / 2, bottom], [port_x[3], depth / 2, bottom - 0.05], gas_size / 2), cylinder([0, depth / 2, top], [0, depth / 2, top + 0.1], flue_size / 2)]"
            }
          },
          {
            "id": "plan_body",
            "op": "rectangle",
            "plane": "xy",
            "args": {
              "min": "[-width / 2, 0]",
              "max": "[width / 2, depth]"
            }
          },
          {
            "id": "plan_clearance",
            "op": "rectangle",
            "plane": "xy",
            "args": {
              "min": "[-width / 2 - clearance_side, depth]",
              "max": "[width / 2 + clearance_side, depth + clearance_front]"
            }
          },
          {
            "id": "plan_code",
            "op": "text",
            "plane": "xy",
            "args": {
              "at": "[0, depth / 2]",
              "value": "symbol_code",
              "height": "0.0025"
            }
          }
        ],
        "opo::representations": [
          {
            "id": "model.low",
            "context": "model",
            "lod": "low",
            "scale": {
              "min_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "body",
                "material": "casing_material"
              }
            ]
          },
          {
            "id": "model.medium",
            "context": "model",
