              }
            ]
          },
          {
            "id": "model.high",
            "context": "model",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "body",
                "material": "casing_material"
              },
              {
                "geometry": "stubs",
                "material": "\"copper\"",
                "part": "Connections"
              }
            ]
          },
          {
            "id": "plan.low",
            "context": "plan",
            "lod": "low",
            "scale": {
              "min_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "plan_body",
                "class": "projected"
              },
              {
                "geometry": "plan_code",
                "class": "annotation"
              }
            ]
          },
          {
            "id": "plan.medium",
            "context": "plan",
            "lod": "medium",
            "scale": {
              "min_scale": 50,
              "max_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "plan_body",
                "class": "projected"
              },
              {
                "geometry": "plan_clearance",
                "class": "annotation",
                "role": "clearance"
              },
              {
                "geometry": "plan_code",
                "class": "annotation"
              }
            ]
          },
          {
            "id": "plan.high",
            "context": "plan",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "derived",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "derive": {
              "from": "model.high",
              "method": "project"
            },
            "overlay": [
              {
                "geometry": "plan_clearance",
                "class": "annotation",
                "role": "clearance"
              }
            ]
          },
          {
            "id": "elevation",
            "context": "elevation",
            "lod": "all",
            "source": "derived",
            "ifc": {
              "context": "Profile",
              "targetView": "ELEVATION_VIEW"
            },
            "derive": {
              "from": "model.{lod}",
              "method": "project"
            }
          },
          {
            "id": "section",
            "context": "section",
            "lod": "all",
            "source": "derived",
            "ifc": {
              "context": "Profile",
              "targetView": "SECTION_VIEW"
            },
            "derive": {
              "from": "model.{lod}",
              "method": "cut"
            }
          }
        ],
        "opo::host": {
          "is_host": false,
          "mounting": {
            "wall": "on_face: back of the body on the wall face",
            "floor": "free: on the floor"
          },
          "insertion": {
            "point": "[0, 0, 0]",
            "description": "Centre of the back edge at floor level; y points away from the wall."
          },
          "clearance": "plan_clearance (annotation zone, used for clash checks; not exported as geometry)"
        },
        "opo::handles": [],
        "opo::materials": {
          "copper": {
            "label": "Copper",
            "category": "metal",
            "colour": "#b87333",
            "cut": {
