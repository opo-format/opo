        },
        "opo::ifc": {
          "class": "IfcBoiler",
          "predefinedType": "if predefined_type = \"USERDEFINED\" or predefined_type = \"NOTDEFINED\" then predefined_type else predefined_type",
          "objectType": "if predefined_type = \"USERDEFINED\" then object_type else null",
          "property_sets": "all parameters of type property_set, with the values set by `value` formulas",
          "properties": {},
          "quantities": {
            "Qto_BoilerBaseQuantities": {
              "values": {},
              "from_geometry": [
                "GrossWeight",
                "NetWeight",
                "TotalSurfaceArea"
              ]
            }
          },
          "parameter_pset": "OPO_Parameters"
        },
        "opo::ports": [
          {
            "name": "heating_flow",
            "system_type": "HEATING",
            "flow_direction": "SOURCE",
            "port_type": "PIPE",
            "nominal_size": "pipe_size",
            "position": "[port_x[1], depth / 2, bottom - 0.05]",
            "direction": "[0, 0, -1]"
          },
          {
            "name": "heating_return",
            "system_type": "HEATING",
            "flow_direction": "SINK",
            "port_type": "PIPE",
            "nominal_size": "pipe_size",
            "position": "[port_x[2], depth / 2, bottom - 0.05]",
            "direction": "[0, 0, -1]"
          },
          {
            "name": "gas",
            "system_type": "GAS",
            "flow_direction": "SINK",
            "port_type": "PIPE",
            "nominal_size": "gas_size",
            "position": "[port_x[3], depth / 2, bottom - 0.05]",
            "direction": "[0, 0, -1]"
          },
          {
            "name": "flue",
            "system_type": "EXHAUST",
            "flow_direction": "SOURCE",
            "port_type": "DUCT",
            "nominal_size": "flue_size",
            "position": "[0, depth / 2, top + 0.1]",
            "direction": "[0, 0, 1]"
          }
        ]
      },
      "children": {
