        "opo::slots": [
          {
            "name": "boundary",
            "type": "polygon",
            "plane": "xy",
            "default": [[0.0, 0.0], [6.0, 0.0], [6.0, 4.0], [0.0, 4.0]],
            "rules": {
              "closed": true,
              "non_self_intersecting": true
            }
          },
          {
            "name": "holes",
            "type": "polygon_list",
            "plane": "xy",
            "default": [],
            "rules": {
              "inside": "boundary"
            }
          }
        ],
        "opo::rules": {
          "derived": [
            {
              "name": "total_thickness",
              "expr": "sum(layers.thickness)"
            },
            {
              "name": "layer_start",
              "expr": "for i in 1..count(layers) return sum(sublist(layers.thickness, 1, i)) - layers[i].thickness",
              "note": "Depth of each layer's top face below the slab top."
            },
            {
              "name": "core_index",
              "expr": "if count(index_of(layers.core, true)) > 0 then index_of(layers.core, true)[1] else ceiling(count(layers) / 2)"
            },
            {
              "name": "top_z",
              "expr": "if reference = \"top\" then elevation_offset else if reference = \"core_top\" then elevation_offset + layer_start[core_index] else elevation_offset + total_thickness"
            },
            {
              "name": "bottom_z",
              "expr": "top_z - total_thickness"
            },
            {
              "name": "gross_area",
              "expr": "abs(sum(for i in 1..count(boundary) return boundary[i][1] * boundary[modulo(i, count(boundary)) + 1][2] - boundary[modulo(i, count(boundary)) + 1][1] * boundary[i][2])) / 2"
            },
            {
              "name": "holes_area",
              "expr": "sum(append(for h in holes return abs(sum(for i in 1..count(h) return h[i][1] * h[modulo(i, count(h)) + 1][2] - h[modulo(i, count(h)) + 1][1] * h[i][2])) / 2, 0))"
            },
            {
              "name": "net_area",
              "expr": "gross_area - holes_area"
            },
            {
              "name": "closed_boundary",
              "expr": "append(boundary, boundary[1])"
            },
            {
              "name": "perimeter",
              "expr": "sum(for i in 1..count(closed_boundary) - 1 return sqrt((closed_boundary[i + 1][1] - closed_boundary[i][1]) ** 2 + (closed_boundary[i + 1][2] - closed_boundary[i][2]) ** 2))"
            }
          ],
          "checks": [
            {
              "id": "has_layers",
              "expr": "count(layers) >= 1",
              "severity": "error",
              "message": "A slab needs at least one layer."
            },
            {
              "id": "layer_thickness",
              "expr": "min(layers.thickness) > 0",
              "severity": "error",
              "message": "Every layer needs a thickness above zero."
            },
            {
              "id": "boundary_points",
              "expr": "count(boundary) >= 3",
              "severity": "error",
              "message": "The boundary needs at least three points."
            }
          ],
          "rulesets": []
        },
        "opo::recipe": [
          {
            "id": "region",
            "op": "difference",
            "plane": "xy",
            "args": {
              "a": "polygon(boundary)",
              "b": "for h in holes return polygon(h)"
            }
          },
          {
            "id": "layer_solids",
            "op": "for_each",
            "plane": "xy",
            "args": {
              "items": "layers",
              "as": "layer",
              "index": "i",
              "do": "extrude(region, top_z - layer_start[i] - layer.thickness, top_z - layer_start[i])"
            }
          },
          {
            "id": "body",
            "op": "extrude",
            "plane": "xy",
            "args": {
              "profile": "region",
              "from": "bottom_z",
              "to": "top_z"
            }
          },
          {
            "id": "edges",
            "op": "boundary_curves",
            "plane": "xy",
            "args": {
              "region": "region"
            }
          }
        ],
        "opo::representations": [
          {
            "id": "model.low",
            "context": "model",
            "lod": "low",
            "scale": {
