            ]
          },
          {
            "id": "plan.medium",
            "context": "plan",
            "lod": "medium",
            "scale": {
              "min_scale": 50,
              "max_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "edges",
                "class": "projected"
              }
            ],
            "note": "A floor slab lies below the plan cut: its edges and holes are drawn as projected lines. Cut slabs (e.g. in a section or a split-level plan) take the derived cut with layer hatches."
          },
          {
            "id": "plan.high",
            "context": "plan",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "edges",
                "class": "projected"
              }
            ]
          },
          {
            "id": "section",
            "context": "section",
            "lod": "all",
            "source": "derived",
            "ifc": {
              "context": "Profile",
              "targetView": "SECTION_VIEW"
            },
            "derive": {
              "from": "model.{lod}",
              "method": "cut"
            },
            "note": "Each cut layer hatched with its material's cut hatch."
          }
        ],
        "opo::host": {
          "is_host": true,
          "accepts": [
            "IfcOpeningElement",
            "IfcVoidingFeature",
            "IfcStair",
            "IfcRamp"
          ],
          "provides": {
            "thickness": "total_thickness",
            "top": "top_z",
            "bottom": "bottom_z"
          },
          "joins": {
            "by": "material",
            "rule": "Layers of the same material join with walls and other slabs without a line."
          },
          "level": "Placed on a storey; z = 0 is the storey elevation."
        },
        "opo::handles": [
          {
            "slot": "boundary",
            "kind": "points",
            "view": [
              "plan"
            ]
          },
          {
            "slot": "holes",
