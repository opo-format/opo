            "type": "choice",
            "default": "FLOOR",
            "label": "Predefined type",
            "group": "IFC",
            "options": [
              "APPROACH_SLAB",
              "BASESLAB",
              "FLOOR",
              "LANDING",
              "PAVING",
              "ROOF",
              "SIDEWALK",
              "TRACKSLAB",
