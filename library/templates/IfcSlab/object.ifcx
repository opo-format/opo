            "IfcSlab",
            "area",
            "class template"
          ],
          "references": [
            {
              "role": "IFC parameters",
              "name": "IFC 4.3 ADD2 IfcSlab, IfcSlabTypeEnum and its property and quantity set templates",
              "license": "buildingSMART",
              "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcSlab",
              "used": "Class, predefined types, property and quantity set names, property names, value types and enumerations (names only)."
            },
            {
              "role": "generator",
              "name": "tools/gen_templates.py",
              "used": "Generated from the `area` archetype (spec/objects/archetypes.md)."
            }
          ]
        },
        "opo::parameters": [
