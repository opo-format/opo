  "schemas": {},
  "data": [
    {
      "path": "5aa2c254-7bf2-5014-ae5a-30f8f6badbe9",
      "attributes": {
        "bsi::ifc::class": {
          "code": "IfcPipeFitting",
          "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcPipeFitting"
        },
        "bsi::ifc::prop::Name": "Pipe fitting (class template)",
        "bsi::ifc::prop::TypeName": "Pipe fitting (class template)",
        "opo::object": {
          "id": "opo-format.org/library/templates/IfcPipeFitting",
          "name": "Pipe fitting (class template)",
          "kind": "class_template",
          "archetype": "fitting",
          "version": "0.1.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "Pipe fitting whose form follows its predefined type: bend, junction (tee), transition (reducer), connector, cap, entry, exit. Sizes follow the connected pipes.",
          "tags": [
            "IfcPipeFitting",
            "fitting",
            "class template"
          ],
          "references": [
            {
              "role": "IFC parameters",
              "name": "IFC 4.3 ADD2 IfcPipeFitting, IfcPipeFittingTypeEnum and its property and quantity set templates",
              "license": "buildingSMART",
              "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcPipeFitting",
              "used": "Class, predefined types, property and quantity set names, property names, value types and enumerations (names only)."
            },
            {
              "role": "generator",
              "name": "tools/gen_templates.py",
              "used": "Generated from the `fitting` archetype (spec/objects/archetypes.md)."
            }
          ]
        },
        "opo::parameters": [
          {
            "name": "predefined_type",
            "type": "choice",
            "default": "BEND",
            "label": "Predefined type",
            "group": "IFC",
            "options": [
              "BEND",
              "CONNECTOR",
              "ENTRY",
              "EXIT",
              "JUNCTION",
              "OBSTRUCTION",
              "TRANSITION",
              "USERDEFINED",
              "NOTDEFINED"
            ],
            "description": "IFC 4.3 IfcPipeFittingTypeEnum. Property sets that apply only to some types follow this choice."
          },
          {
            "name": "object_type",
            "type": "text",
            "default": "",
            "label": "Object type (user-defined)",
            "group": "IFC",
            "visible": "predefined_type = \"USERDEFINED\""
          },
          {
            "name": "outer_diameter",
            "type": "length",
            "default": 0.05,
            "label": "Outside diameter",
            "group": "Size",
            "limits": {
              "min": 0.006,
              "max": 3
            }
          },
          {
            "name": "wall_thickness",
            "type": "length",
            "default": 0.003,
            "label": "Wall thickness",
            "group": "Size",
            "limits": {
              "min": 0.0005,
              "max": 0.1
            }
          },
          {
            "name": "bend_angle",
            "type": "angle",
            "default": 90.0,
            "label": "Bend angle",
            "group": "Bend",
            "visible": "predefined_type = \"BEND\"",
            "limits": {
              "min": 1,
              "max": 180
            }
          },
          {
            "name": "bend_radius_factor",
            "type": "number",
            "default": 1.5,
            "label": "Bend radius ÷ outside diameter",
            "group": "Bend",
            "visible": "predefined_type = \"BEND\"",
            "limits": {
              "min": 0.6,
              "max": 10
            }
          },
          {
            "name": "branch_diameter",
            "type": "length",
            "default": 0.05,
            "label": "Branch outside diameter",
            "group": "Junction",
            "visible": "predefined_type = \"JUNCTION\"",
            "limits": {
              "min": 0.006,
              "max": 3
            }
          },
          {
            "name": "outer_diameter_2",
            "type": "length",
            "default": 0.04,
            "label": "Outlet outside diameter",
            "group": "Transition",
            "visible": "predefined_type = \"TRANSITION\"",
            "limits": {
              "min": 0.006,
              "max": 3
            }
          },
          {
            "name": "fitting_length",
            "type": "length",
            "default": 0.1,
            "label": "Length",
            "group": "Size",
            "visible": "predefined_type != \"BEND\" and predefined_type != \"JUNCTION\"",
            "limits": {
              "min": 0.005,
              "max": 3
            }
          },
          {
            "name": "material",
            "type": "material",
            "default": "copper",
            "label": "Material",
            "group": "Materials",
            "options": "materials"
          },
          {
            "name": "Pset_PipeFittingOccurrence",
            "type": "property_set",
            "default": {},
            "label": "Pset_PipeFittingOccurrence",
            "group": "IFC data",
            "properties": [
              {
                "name": "InteriorRoughnessCoefficient",
                "measure": "IfcPositiveLengthMeasure"
              },
              {
                "name": "Colour",
                "measure": "IfcLabel"
              }
            ],
            "optional": false
          },
          {
            "name": "Pset_PipeFittingPHistory",
            "type": "property_set",
            "default": {},
            "label": "Pset_PipeFittingPHistory",
            "group": "IFC data",
            "properties": [
              {
                "name": "LossCoefficient",
                "measure": "IfcTimeSeries"
              },
              {
                "name": "FlowrateLeakage",
                "measure": "IfcTimeSeries"
              }
            ],
            "optional": false
          },
          {
            "name": "Pset_PipeFittingTypeCommon",
            "type": "property_set",
            "default": {},
            "label": "Pset_PipeFittingTypeCommon",
            "group": "IFC data",
            "properties": [
              {
                "name": "Reference",
                "measure": "IfcIdentifier"
              },
              {
                "name": "Status",
                "measure": "IfcLabel",
                "enum": [
                  "DEMOLISH",
                  "EXISTING",
                  "NEW",
                  "TEMPORARY",
                  "OTHER",
                  "NOTKNOWN",
                  "UNSET"
                ]
              },
              {
                "name": "PressureClass",
                "measure": "IfcPressureMeasure"
              },
              {
                "name": "PressureRange",
                "measure": "IfcPressureMeasure"
              },
              {
                "name": "TemperatureRange",
                "measure": "IfcThermodynamicTemperatureMeasure"
              },
              {
                "name": "FittingLossFactor",
                "measure": "IfcReal"
              }
            ],
            "optional": false
          }
        ],
        "opo::slots": [],
        "opo::rules": {
          "derived": [
            {
              "name": "r",
              "expr": "outer_diameter / 2"
            },
            {
              "name": "bend_radius",
              "expr": "bend_radius_factor * outer_diameter"
            },
            {
              "name": "bend_end",
              "expr": "[bend_radius * sin(bend_angle), bend_radius - bend_radius * cos(bend_angle), 0]"
            },
            {
              "name": "run_length",
              "expr": "max(3 * outer_diameter, 2 * branch_diameter)"
            },
            {
              "name": "socket_d",
              "expr": "outer_diameter + 2 * wall_thickness",
              "note": "Connector body diameter (sleeve over the pipe)."
            },
            {
              "name": "is_bend",
              "expr": "predefined_type = \"BEND\""
            },
            {
              "name": "is_junction",
              "expr": "predefined_type = \"JUNCTION\""
            },
            {
              "name": "is_transition",
              "expr": "predefined_type = \"TRANSITION\""
            },
            {
              "name": "is_cap",
              "expr": "predefined_type = \"OBSTRUCTION\""
            },
            {
              "name": "is_straight",
              "expr": "not(is_bend or is_junction or is_transition or is_cap)",
              "note": "CONNECTOR, ENTRY, EXIT, USERDEFINED, NOTDEFINED: a straight sleeve."
            },
            {
              "name": "length",
              "expr": "if is_bend then 3.141592653589793 * bend_radius * bend_angle / 180 else if is_junction then run_length else fitting_length"
            }
          ],
          "checks": [
            {
              "id": "bend_radius_ok",
              "expr": "not(is_bend) or bend_radius > r",
              "severity": "error",
              "message": "The bend radius must be larger than the pipe radius."
            },
            {
              "id": "branch_ok",
              "expr": "not(is_junction) or branch_diameter <= outer_diameter",
              "severity": "warning",
              "message": "A branch larger than the run is unusual; check the sizes."
            }
          ],
          "rulesets": []
        },
        "opo::recipe": [
          {
            "id": "bend_body",
            "op": "revolve",
            "plane": "yz",
            "when": "is_bend",
            "args": {
              "profile": "circle([0, 0], r)",
              "center": "[0, bend_radius, 0]",
              "axis": "[0, 0, 1]",
              "angle": "bend_angle"
            }
          },
          {
            "id": "junction_body",
            "op": "union",
            "when": "is_junction",
            "args": {
              "items": "[cylinder([0, 0, 0], [run_length, 0, 0], r), cylinder([run_length / 2, 0, 0], [run_length / 2, run_length / 2, 0], branch_diameter / 2)]"
            }
          },
          {
            "id": "transition_body",
            "op": "revolve",
            "plane": "xy",
            "when": "is_transition",
            "args": {
              "profile": "polygon([[0, 0], [fitting_length, 0], [fitting_length, outer_diameter_2 / 2], [0, r]])",
              "center": "[0, 0, 0]",
              "axis": "[1, 0, 0]",
              "angle": "360"
            },
            "note": "Concentric reducer."
          },
          {
            "id": "cap_body",
            "op": "cylinder",
            "when": "is_cap",
            "args": {
              "start": "[0, 0, 0]",
              "end": "[fitting_length, 0, 0]",
              "radius": "socket_d / 2"
            }
          },
          {
            "id": "sleeve_body",
            "op": "cylinder",
            "when": "is_straight",
            "args": {
              "start": "[0, 0, 0]",
              "end": "[fitting_length, 0, 0]",
              "radius": "socket_d / 2"
            }
          },
          {
            "id": "body",
            "op": "union",
            "args": {
              "items": "[bend_body, junction_body, transition_body, cap_body, sleeve_body]"
            }
          },
          {
            "id": "bend_axis",
            "op": "arc",
            "plane": "xy",
            "when": "is_bend",
            "args": {
              "center": "[0, bend_radius]",
              "radius": "bend_radius",
              "start_angle": "-90",
              "end_angle": "-90 + bend_angle"
            }
          },
          {
            "id": "straight_axis",
            "op": "line",
            "plane": "xy",
            "when": "not(is_bend)",
            "args": {
              "start": "[0, 0]",
              "end": "[length, 0]"
            }
          },
          {
            "id": "branch_axis",
            "op": "line",
            "plane": "xy",
            "when": "is_junction",
            "args": {
              "start": "[run_length / 2, 0]",
              "end": "[run_length / 2, run_length / 2]"
            }
          },
          {
            "id": "single_line",
            "op": "union",
            "args": {
              "items": "[bend_axis, straight_axis, branch_axis]"
            }
          },
          {
            "id": "plan_bend",
            "op": "band",
            "plane": "xy",
            "when": "is_bend",
            "args": {
              "path": "bend_axis",
              "left": "r",
              "right": "-r"
            }
          },
          {
            "id": "plan_junction",
            "op": "union",
            "plane": "xy",
            "when": "is_junction",
            "args": {
              "items": "[rectangle([0, -r], [run_length, r]), rectangle([run_length / 2 - branch_diameter / 2, 0], [run_length / 2 + branch_diameter / 2, run_length / 2])]"
            }
          },
          {
            "id": "plan_transition",
            "op": "polygon",
            "plane": "xy",
            "when": "is_transition",
            "args": {
              "points": "[[0, -r], [fitting_length, -outer_diameter_2 / 2], [fitting_length, outer_diameter_2 / 2], [0, r]]"
            }
          },
          {
            "id": "plan_straight",
            "op": "rectangle",
            "plane": "xy",
            "when": "is_cap or is_straight",
            "args": {
              "min": "[0, -socket_d / 2]",
              "max": "[fitting_length, socket_d / 2]"
            }
          },
          {
            "id": "plan_outline",
            "op": "union",
            "plane": "xy",
            "args": {
              "items": "[plan_bend, plan_junction, plan_transition, plan_straight]"
            }
          }
        ],
        "opo::representations": [
          {
            "id": "model.low",
            "context": "model",
            "lod": "low",
            "scale": {
              "min_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "body",
                "material": "material"
              }
            ]
          },
          {
            "id": "model.medium",
            "context": "model",
            "lod": "medium",
            "scale": {
              "min_scale": 50,
              "max_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "body",
                "material": "material"
              }
            ]
          },
          {
            "id": "model.high",
            "context": "model",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "body",
                "material": "material"
              }
            ]
          },
          {
            "id": "plan.low",
            "context": "plan",
            "lod": "low",
            "scale": {
              "min_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "single_line",
                "class": "projected"
              }
            ],
            "note": "Single-line drawing at small scales."
          },
          {
            "id": "plan.medium",
            "context": "plan",
            "lod": "medium",
            "scale": {
              "min_scale": 50,
              "max_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "plan_outline",
                "class": "projected"
              }
            ]
          },
          {
            "id": "plan.high",
            "context": "plan",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "plan_outline",
                "class": "projected"
              }
            ]
          },
          {
            "id": "section",
            "context": "section",
            "lod": "all",
            "source": "derived",
            "ifc": {
              "context": "Profile",
              "targetView": "SECTION_VIEW"
            },
            "derive": {
              "from": "model.{lod}",
              "method": "cut"
            }
          }
        ],
        "opo::host": {
          "is_host": false,
          "placement": "Snapped to the ends of pipe segments; the application inserts fittings where segments meet.",
          "insertion": {
            "point": "[0, 0, 0]",
            "description": "Port 1 (inlet) at the origin, pointing along -x."
          }
        },
        "opo::handles": [],
        "opo::materials": {
          "copper": {
            "label": "Copper",
            "category": "metal",
            "colour": "#b87333",
            "cut": {
              "hatch": "solid_dark"
            },
            "ifc_name": "Copper"
          }
        },
        "opo::hatches": {
          "solid_dark": {
            "label": "Solid, dark",
            "kind": "solid",
            "colour": "#3a3a3a"
          }
        },
        "opo::ifc": {
          "class": "IfcPipeFitting",
          "predefinedType": "if predefined_type = \"USERDEFINED\" or predefined_type = \"NOTDEFINED\" then predefined_type else predefined_type",
          "objectType": "if predefined_type = \"USERDEFINED\" then object_type else null",
          "property_sets": "all parameters of type property_set, with the values set by `value` formulas",
          "properties": {},
          "quantities": {
            "Qto_PipeFittingBaseQuantities": {
              "values": {
                "Length": "length",
                "GrossCrossSectionArea": "3.141592653589793 * r ** 2",
                "NetCrossSectionArea": "3.141592653589793 * (r ** 2 - (r - wall_thickness) ** 2)"
              },
              "from_geometry": [
                "OuterSurfaceArea",
                "GrossWeight",
                "NetWeight"
              ]
            }
          },
          "parameter_pset": "OPO_Parameters"
        },
        "opo::ports": [
          {
            "name": "port_1",
            "system_type": "NOTDEFINED",
            "flow_direction": "SOURCEANDSINK",
            "port_type": "PIPE",
            "nominal_size": "outer_diameter",
            "position": "[0, 0, 0]",
            "direction": "[-1, 0, 0]"
          },
          {
            "name": "port_2",
            "system_type": "NOTDEFINED",
            "flow_direction": "SOURCEANDSINK",
            "port_type": "PIPE",
            "nominal_size": "if is_transition then outer_diameter_2 else outer_diameter",
            "when": "not(is_cap) and predefined_type != \"ENTRY\" and predefined_type != \"EXIT\"",
            "position": "if is_bend then bend_end else [length, 0, 0]",
            "direction": "if is_bend then [cos(bend_angle), sin(bend_angle), 0] else [1, 0, 0]"
          },
          {
            "name": "branch",
            "system_type": "NOTDEFINED",
            "flow_direction": "SOURCEANDSINK",
            "port_type": "PIPE",
            "nominal_size": "branch_diameter",
            "when": "is_junction",
            "position": "[run_length / 2, run_length / 2, 0]",
            "direction": "[0, 1, 0]"
          }
        ]
      },
      "children": {
        "Model_body_1": "dbad9bf6-fb46-5cd0-9d3a-e68485029586",
        "Plan_plan_outline_1": "6215928d-e0a6-5a87-b169-8e3f0be34059"
      }
    },
    {
      "path": "dbad9bf6-fb46-5cd0-9d3a-e68485029586",
      "attributes": {
        "opo::representation": "model.medium",
