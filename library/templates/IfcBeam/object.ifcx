          {
            "id": "model.high",
            "context": "model",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
