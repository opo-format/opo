                "material": "material"
              }
            ]
          },
          {
            "id": "plan.low",
            "context": "plan",
            "lod": "low",
            "scale": {
              "min_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "plan_axis",
                "class": "overhead"
              }
            ]
          },
          {
            "id": "plan.medium",
            "context": "plan",
            "lod": "medium",
            "scale": {
              "min_scale": 50,
              "max_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "plan_band",
                "class": "overhead"
              }
            ],
            "note": "Drawn as overhead outline (members above the plan cut). Where the member is cut by the plan (columns), the derived cut applies."
          },
          {
            "id": "plan.high",
            "context": "plan",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "derived",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "derive": {
              "from": "model.high",
              "method": "cut_or_project"
            }
          },
          {
            "id": "section",
