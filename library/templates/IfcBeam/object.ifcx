            "options": [
              "left",
              "centre",
              "right"
            ]
          },
          {
            "name": "justification_v",
            "type": "choice",
            "default": "top",
            "label": "Vertical justification",
            "group": "Placement",
            "options": [
              "top",
              "centre",
              "bottom"
            ]
          },
          {
            "name": "roll",
            "type": "angle",
            "default": 0.0,
            "label": "Rotation about the axis",
            "group": "Placement",
            "limits": {
              "min": -180,
              "max": 180
