        ],
        "opo::slots": [
          {
            "name": "path",
            "type": "polyline3",
            "default": [[0.0, 0.0, 0.0], [5.0, 0.0, 0.0]],
            "rules": {
              "open": true,
              "min_segment_length": 0.01
            },
            "description": "Axis of the member (the justification point of the profile follows it)."
          }
        ],
        "opo::rules": {
          "derived": [
            {
              "name": "cu",
              "expr": "if justification_h = \"left\" then -width / 2 else if justification_h = \"right\" then width / 2 else 0",
              "note": "Profile centre, across."
            },
            {
              "name": "profile_height",
              "expr": "if profile_kind = \"circle\" or profile_kind = \"circ_hollow\" then width else depth"
            },
            {
              "name": "cv",
              "expr": "if justification_v = \"top\" then -profile_height / 2 else if justification_v = \"bottom\" then profile_height / 2 else 0",
              "note": "Profile centre, up."
            },
            {
              "name": "seg_start",
              "expr": "[path[2][1] - path[1][1], path[2][2] - path[1][2], path[2][3] - path[1][3]]"
            },
            {
              "name": "seg_end",
              "expr": "[path[count(path)][1] - path[count(path) - 1][1], path[count(path)][2] - path[count(path) - 1][2], path[count(path)][3] - path[count(path) - 1][3]]"
            },
            {
              "name": "len_start",
              "expr": "sqrt(seg_start[1] ** 2 + seg_start[2] ** 2 + seg_start[3] ** 2)"
            },
            {
              "name": "len_end",
              "expr": "sqrt(seg_end[1] ** 2 + seg_end[2] ** 2 + seg_end[3] ** 2)"
            },
            {
              "name": "p_start",
              "expr": "for k in 1..3 return path[1][k] - seg_start[k] / len_start * start_extension"
            },
            {
              "name": "p_end",
              "expr": "for k in 1..3 return path[count(path)][k] + seg_end[k] / len_end * end_extension"
            },
            {
              "name": "axis_path",
              "expr": "concatenate([p_start], sublist(path, 2, count(path) - 2), [p_end])",
              "note": "Axis with the end extensions applied."
            },
            {
              "name": "length",
              "expr": "sum(for i in 1..count(axis_path) - 1 return sqrt((axis_path[i + 1][1] - axis_path[i][1]) ** 2 + (axis_path[i + 1][2] - axis_path[i][2]) ** 2 + (axis_path[i + 1][3] - axis_path[i][3]) ** 2))"
            },
            {
              "name": "plan_path",
              "expr": "for p in axis_path return [p[1], p[2]]"
            },
            {
              "name": "area",
              "expr": "if profile_kind = \"rectangle\" then width * depth else if profile_kind = \"i_section\" then 2 * width * flange_thickness + (depth - 2 * flange_thickness) * web_thickness else if profile_kind = \"circle\" then 3.141592653589793 * (width / 2) ** 2 else if profile_kind = \"rect_hollow\" then width * depth - (width - 2 * wall_thickness) * (depth - 2 * wall_thickness) else if profile_kind = \"circ_hollow\" then 3.141592653589793 * ((width / 2) ** 2 - (width / 2 - wall_thickness) ** 2) else if profile_kind = \"channel\" then 2 * width * flange_thickness + (depth - 2 * flange_thickness) * web_thickness else (width + depth - wall_thickness) * wall_thickness",
              "note": "Cross-section area (fillets ignored)."
            },
            {
              "name": "density",
              "expr": "if material = \"steel\" then 7850 else if material = \"reinforced_concrete\" then 2500 else if material = \"concrete\" then 2400 else null",
              "note": "From the material (null if the material has no density)."
            }
          ],
          "checks": [
            {
              "id": "path_points",
              "expr": "count(path) >= 2",
              "severity": "error",
              "message": "The path needs at least two points."
            },
            {
              "id": "walls_fit",
              "expr": "not((profile_kind = \"rect_hollow\" or profile_kind = \"circ_hollow\") and 2 * wall_thickness >= min(width, profile_height))",
              "severity": "error",
              "message": "The wall thickness is too large for the profile."
            },
            {
              "id": "flanges_fit",
              "expr": "not((profile_kind = \"i_section\" or profile_kind = \"channel\") and (2 * flange_thickness >= depth or web_thickness >= width))",
              "severity": "error",
              "message": "Flanges or web do not fit in the profile."
            }
          ],
          "rulesets": []
        },
        "opo::recipe": [
          {
            "id": "profile",
            "op": "union",
            "plane": "profile",
            "args": {
              "items": "[if profile_kind = \"rectangle\" then rectangle([cu + -width / 2, cv + -depth / 2], [cu + width / 2, cv + depth / 2]) else if profile_kind = \"i_section\" then union([rectangle([cu + -width / 2, cv + depth / 2 - flange_thickness], [cu + width / 2, cv + depth / 2]), rectangle([cu + -width / 2, cv + -depth / 2], [cu + width / 2, cv + -depth / 2 + flange_thickness]), rectangle([cu + -web_thickness / 2, cv + -depth / 2], [cu + web_thickness / 2, cv + depth / 2])]) else if profile_kind = \"circle\" then circle([cu, cv], width / 2) else if profile_kind = \"rect_hollow\" then difference(rectangle([cu + -width / 2, cv + -depth / 2], [cu + width / 2, cv + depth / 2]), rectangle([cu + -width / 2 + wall_thickness, cv + -depth / 2 + wall_thickness], [cu + width / 2 - wall_thickness, cv + depth / 2 - wall_thickness])) else if profile_kind = \"circ_hollow\" then difference(circle([cu, cv], width / 2), circle([cu, cv], width / 2 - wall_thickness)) else if profile_kind = \"channel\" then union([rectangle([cu + -width / 2, cv + depth / 2 - flange_thickness], [cu + width / 2, cv + depth / 2]), rectangle([cu + -width / 2, cv + -depth / 2], [cu + width / 2, cv + -depth / 2 + flange_thickness]), rectangle([cu + -width / 2, cv + -depth / 2], [cu + -width / 2 + web_thickness, cv + depth / 2])]) else union([rectangle([cu + -width / 2, cv + -depth / 2], [cu + -width / 2 + wall_thickness, cv + depth / 2]), rectangle([cu + -width / 2, cv + -depth / 2], [cu + width / 2, cv + -depth / 2 + wall_thickness])])]"
            },
            "note": "Profile in its own plane: u across (left of travel), v up."
          },
          {
            "id": "body",
            "op": "sweep",
            "args": {
              "profile": "profile",
              "path": "axis_path",
              "roll": "roll"
            }
          },
          {
            "id": "axis",
            "op": "path3",
            "args": {
              "points": "axis_path"
            }
          },
          {
            "id": "plan_band",
            "op": "band",
            "plane": "xy",
            "args": {
              "path": "plan_path",
              "left": "cu + width / 2",
              "right": "cu - width / 2"
            }
          },
          {
            "id": "plan_axis",
            "op": "polyline",
            "plane": "xy",
            "args": {
              "points": "plan_path"
            }
          }
        ],
        "opo::representations": [
          {
            "id": "model.low",
            "context": "model",
            "lod": "low",
