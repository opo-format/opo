              "NOTDEFINED"
            ],
            "description": "IFC 4.3 IfcBeamTypeEnum. Property sets that apply only to some types follow this choice."
          },
          {
            "name": "object_type",
            "type": "text",
            "default": "",
            "label": "Object type (user-defined)",
            "group": "IFC",
            "visible": "predefined_type = \"USERDEFINED\""
          },
          {
            "name": "profile_kind",
            "type": "choice",
            "default": "rectangle",
            "label": "Profile",
            "group": "Profile",
            "options": [
              "rectangle",
              "i_section",
              "circle",
              "rect_hollow",
              "circ_hollow",
              "channel",
              "angle"
            ],
            "option_labels": {
              "rectangle": "Rectangle",
              "i_section": "I / H section",
              "circle": "Circle",
              "rect_hollow": "Rectangular hollow",
              "circ_hollow": "Circular hollow",
              "channel": "Channel (U)",
              "angle": "Angle (L)"
            },
            "description": "Profiles from the shared profile library set these values by variant."
          },
          {
            "name": "profile_name",
            "type": "text",
            "default": "",
            "label": "Profile designation",
            "group": "Profile",
            "description": "E.g. IPE 270; written to IFC ProfileName."
          },
          {
            "name": "width",
            "type": "length",
            "default": 0.25,
            "label": "Width / diameter",
            "group": "Profile",
            "limits": {
              "min": 0.005,
              "max": 5
            }
          },
          {
            "name": "depth",
            "type": "length",
            "default": 0.5,
            "label": "Depth",
            "group": "Profile",
            "visible": "profile_kind != \"circle\" and profile_kind != \"circ_hollow\"",
            "limits": {
              "min": 0.005,
              "max": 5
            }
          },
          {
            "name": "web_thickness",
            "type": "length",
            "default": 0.008,
            "label": "Web thickness",
            "group": "Profile",
            "visible": "profile_kind = \"i_section\" or profile_kind = \"channel\"",
            "limits": {
              "min": 0.001,
              "max": 0.2
            }
          },
          {
            "name": "flange_thickness",
            "type": "length",
            "default": 0.012,
            "label": "Flange thickness",
            "group": "Profile",
            "visible": "profile_kind = \"i_section\" or profile_kind = \"channel\"",
            "limits": {
              "min": 0.001,
              "max": 0.2
            }
          },
          {
            "name": "wall_thickness",
            "type": "length",
            "default": 0.006,
            "label": "Wall / leg thickness",
            "group": "Profile",
            "visible": "profile_kind = \"rect_hollow\" or profile_kind = \"circ_hollow\" or profile_kind = \"angle\"",
            "limits": {
              "min": 0.001,
              "max": 0.2
            }
          },
          {
            "name": "justification_h",
            "type": "choice",
            "default": "centre",
            "label": "Horizontal justification",
