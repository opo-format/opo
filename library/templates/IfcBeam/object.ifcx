        "bsi::ifc::prop::Name": "Beam (class template)",
        "bsi::ifc::prop::TypeName": "Beam (class template)",
        "opo::object": {
          "id": "opo-format.org/library/templates/IfcBeam",
          "name": "Beam (class template)",
          "kind": "class_template",
          "archetype": "linear",
          "version": "0.1.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "Member with a profile swept along a path: parametric profile (rectangle, I, circle, hollow sections, channel, angle), justification, roll and end extensions.",
          "tags": [
            "IfcBeam",
            "linear",
            "class template"
          ],
          "references": [
            {
              "role": "IFC parameters",
              "name": "IFC 4.3 ADD2 IfcBeam, IfcBeamTypeEnum and its property and quantity set templates",
              "license": "buildingSMART",
              "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcBeam",
              "used": "Class, predefined types, property and quantity set names, property names, value types and enumerations (names only)."
            },
            {
              "role": "generator",
              "name": "tools/gen_templates.py",
              "used": "Generated from the `linear` archetype (spec/objects/archetypes.md)."
            }
          ]
        },
        "opo::parameters": [
          {
            "name": "predefined_type",
            "type": "choice",
            "default": "BEAM",
            "label": "Predefined type",
            "group": "IFC",
            "options": [
              "BEAM",
              "CORNICE",
              "DIAPHRAGM",
              "EDGEBEAM",
              "GIRDER_SEGMENT",
              "HATSTONE",
