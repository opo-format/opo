      "attributes": {
        "bsi::ifc::class": {
          "code": "IfcWall",
          "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcWall"
        },
        "bsi::ifc::prop::Name": "Wall (class template)",
        "bsi::ifc::prop::TypeName": "Wall (class template)",
        "opo::object": {
          "id": "opo-format.org/library/templates/IfcWall",
          "name": "Wall (class template)",
          "kind": "class_template",
          "archetype": "wall",
          "version": "0.1.0",
          "opo": "0.1",
          "license": "CC0-1.0",
          "author": "OPO format contributors",
          "description": "Layered wall along a path: build-up of materials with hatches, location line, base and top constraints. Hosts doors, windows and openings.",
          "tags": [
            "IfcWall",
            "wall",
            "class template"
          ],
          "references": [
            {
              "role": "IFC parameters",
              "name": "IFC 4.3 ADD2 IfcWall, IfcWallTypeEnum and its property and quantity set templates",
              "license": "buildingSMART",
              "uri": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcWall",
              "used": "Class, predefined types, property and quantity set names, property names, value types and enumerations (names only)."
            },
            {
              "role": "generator",
              "name": "tools/gen_templates.py",
              "used": "Generated from the `wall` archetype (spec/objects/archetypes.md)."
            }
          ]
        },
        "opo::parameters": [
          {
            "name": "predefined_type",
            "type": "choice",
            "default": "STANDARD",
            "label": "Predefined type",
            "group": "IFC",
            "options": [
              "ELEMENTEDWALL",
              "MOVABLE",
              "PARAPET",
              "PARTITIONING",
              "PLUMBINGWALL",
              "POLYGONAL",
              "RETAININGWALL",
              "SHEAR",
              "SOLIDWALL",
              "STANDARD",
              "WAVEWALL",
              "USERDEFINED",
              "NOTDEFINED"
            ],
            "description": "IFC 4.3 IfcWallTypeEnum. Property sets that apply only to some types follow this choice."
          },
          {
            "name": "object_type",
            "type": "text",
            "default": "",
            "label": "Object type (user-defined)",
            "group": "IFC",
            "visible": "predefined_type = \"USERDEFINED\""
          },
          {
            "name": "layers",
            "type": "layers",
            "default": [
              {
                "material": "plaster",
                "thickness": 0.015,
                "function": "finish"
              },
              {
                "material": "concrete_block",
                "thickness": 0.2,
                "function": "structure",
                "core": true
              },
              {
                "material": "plaster",
                "thickness": 0.015,
                "function": "finish"
              }
            ],
            "label": "Layers (left to right)",
            "group": "Construction",
            "description": "Layer build-up: list of {material, thickness, function, core}. Each material carries its cut hatch (opo::materials, opo::hatches), so the type keeps its look when shared.",
            "limits": {
              "thickness": {
                "min": 0.001,
                "max": 2.0
              }
            }
          },
          {
            "name": "location_line",
            "type": "choice",
            "default": "wall_centre",
            "label": "Location line",
            "group": "Construction",
            "options": [
              "wall_centre",
              "core_centre",
              "finish_left",
              "finish_right",
              "core_left",
              "core_right"
            ],
            "description": "Which line of the build-up sits on the path."
          },
          {
            "name": "top_mode",
            "type": "choice",
            "default": "storey",
            "label": "Top constraint",
            "group": "Height",
            "options": [
              "storey",
              "unconnected"
            ],
            "option_labels": {
              "storey": "Up to the next storey (+ top offset)",
              "unconnected": "Unconnected height"
            }
          },
          {
            "name": "unconnected_height",
            "type": "length",
            "default": 2.7,
            "label": "Unconnected height",
            "group": "Height",
            "visible": "top_mode = \"unconnected\"",
            "limits": {
              "min": 0.05,
              "max": 50
            }
          },
          {
            "name": "base_offset",
            "type": "length",
            "default": 0.0,
            "label": "Base offset",
            "group": "Height",
            "limits": {
              "min": -10,
              "max": 10
            }
          },
          {
            "name": "top_offset",
