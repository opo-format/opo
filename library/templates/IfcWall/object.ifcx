        ],
        "opo::slots": [
          {
            "name": "path",
            "type": "polyline",
            "plane": "xy",
            "default": [[0.0, 0.0], [5.0, 0.0]],
            "rules": {
              "open": true,
              "min_segment_length": 0.01
            },
            "description": "Wall path in plan. Layers are listed from the left of the direction of travel to the right."
          }
        ],
        "opo::rules": {
          "derived": [
            {
              "name": "total_thickness",
              "expr": "sum(layers.thickness)"
            },
            {
              "name": "layer_start",
              "expr": "for i in 1..count(layers) return sum(sublist(layers.thickness, 1, i)) - layers[i].thickness",
              "note": "Distance of each layer's left face from the wall's left face."
            },
            {
              "name": "core_index",
              "expr": "if count(index_of(layers.core, true)) > 0 then index_of(layers.core, true)[1] else ceiling(count(layers) / 2)",
              "note": "First layer marked core, else the middle layer."
            },
            {
              "name": "core_start",
              "expr": "layer_start[core_index]"
            },
            {
              "name": "core_end",
              "expr": "core_start + layers[core_index].thickness"
            },
            {
              "name": "left_face",
              "expr": "if location_line = \"wall_centre\" then total_thickness / 2 else if location_line = \"core_centre\" then (core_start + core_end) / 2 else if location_line = \"finish_left\" then 0 else if location_line = \"finish_right\" then total_thickness else if location_line = \"core_left\" then core_start else core_end",
              "note": "Offset of the left face from the path (positive = left)."
            },
            {
              "name": "height",
              "expr": "if top_mode = \"storey\" then level.height + top_offset - base_offset else unconnected_height"
            },
            {
              "name": "bottom",
              "expr": "base_offset"
            },
            {
              "name": "top",
              "expr": "base_offset + height"
            },
            {
              "name": "path_length",
              "expr": "sum(for i in 1..count(path) - 1 return sqrt((path[i + 1][1] - path[i][1]) ** 2 + (path[i + 1][2] - path[i][2]) ** 2))"
            }
          ],
          "checks": [
            {
              "id": "has_layers",
              "expr": "count(layers) >= 1",
              "severity": "error",
              "message": "A wall needs at least one layer."
            },
            {
              "id": "layer_thickness",
              "expr": "min(layers.thickness) > 0",
              "severity": "error",
              "message": "Every layer needs a thickness above zero."
            },
            {
              "id": "height_positive",
              "expr": "height > 0",
              "severity": "error",
              "message": "The wall top is below its base."
            }
          ],
          "rulesets": []
        },
        "opo::recipe": [
          {
            "id": "layer_bands",
            "op": "for_each",
            "plane": "xy",
            "args": {
              "items": "layers",
              "as": "layer",
              "index": "i",
              "do": "band(path, left_face - layer_start[i], left_face - layer_start[i] - layer.thickness)"
            }
          },
          {
            "id": "layer_solids",
            "op": "for_each",
            "plane": "xy",
            "args": {
              "items": "layer_bands",
              "as": "b",
              "index": "i",
              "do": "extrude(b, bottom, top)"
            },
            "note": "Each item keeps its layer (each.material) from layer_bands."
          },
          {
            "id": "outline",
            "op": "band",
            "plane": "xy",
            "args": {
              "path": "path",
              "left": "left_face",
              "right": "left_face - total_thickness"
            }
          },
          {
            "id": "body",
            "op": "extrude",
            "plane": "xy",
            "args": {
              "profile": "outline",
              "from": "bottom",
              "to": "top"
            }
          },
          {
            "id": "axis",
            "op": "polyline",
            "plane": "xy",
            "args": {
              "points": "path"
            }
          }
        ],
        "opo::representations": [
          {
            "id": "model.low",
            "context": "model",
            "lod": "low",
            "scale": {
              "min_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "body",
                "material": "layers[core_index].material"
              }
            ]
          },
          {
            "id": "model.medium",
            "context": "model",
            "lod": "medium",
            "scale": {
              "min_scale": 50,
              "max_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "layer_solids",
                "material": "each.material",
                "part": "Layer"
              }
            ]
          },
          {
            "id": "model.high",
            "context": "model",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "authored",
            "ifc": {
              "context": "Body",
              "targetView": "MODEL_VIEW"
            },
            "items": [
              {
                "geometry": "layer_solids",
                "material": "each.material",
                "part": "Layer"
              }
            ]
          },
          {
            "id": "plan.low",
            "context": "plan",
            "lod": "low",
            "scale": {
              "min_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "outline",
                "class": "cut",
                "hatch": "layers[core_index].material",
                "role": "outline"
              }
            ],
            "note": "Whole wall in one outline, hatched with the core material."
          },
          {
            "id": "plan.medium",
            "context": "plan",
            "lod": "medium",
            "scale": {
              "min_scale": 50,
              "max_scale": 200
            },
            "source": "authored",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "items": [
              {
                "geometry": "layer_bands",
                "class": "cut",
                "hatch": "each.material",
                "role": "layer"
              },
              {
                "geometry": "outline",
                "class": "cut",
                "role": "outline"
              }
            ],
            "note": "Each layer hatched with its material's cut hatch; layer lines thin, outline heavy (weights from the drawing style)."
          },
          {
            "id": "plan.high",
            "context": "plan",
            "lod": "high",
            "scale": {
              "max_scale": 50
            },
            "source": "derived",
            "ifc": {
              "context": "Plan",
              "targetView": "PLAN_VIEW"
            },
            "derive": {
              "from": "model.high",
              "method": "cut"
            },
            "note": "Cut from the layer solids; hatches from each layer's material."
          },
          {
            "id": "elevation",
            "context": "elevation",
            "lod": "all",
            "source": "derived",
            "ifc": {
              "context": "Profile",
              "targetView": "ELEVATION_VIEW"
            },
            "derive": {
              "from": "model.{lod}",
              "method": "project"
            },
            "surface": "each layer's material surface pattern on visible faces (e.g. brick coursing)"
          },
          {
            "id": "section",
            "context": "section",
            "lod": "all",
            "source": "derived",
            "ifc": {
              "context": "Profile",
              "targetView": "SECTION_VIEW"
            },
            "derive": {
              "from": "model.{lod}",
              "method": "cut"
            }
          },
          {
            "id": "axis",
            "context": "axis",
            "lod": "all",
            "source": "authored",
            "ifc": {
              "context": "Axis",
              "targetView": "GRAPH_VIEW"
            },
            "items": [
              {
                "geometry": "axis",
                "class": "annotation"
              }
            ]
          }
        ],
        "opo::host": {
          "is_host": true,
          "accepts": [
            "IfcDoor",
            "IfcWindow",
            "IfcOpeningElement",
            "IfcVoidingFeature",
            "IfcProjectionElement",
            "IfcShadingDevice"
          ],
          "provides": {
            "thickness": "total_thickness",
            "y_max": "left_face",
            "y_min": "left_face - total_thickness",
            "bottom": "bottom",
            "top": "top"
          },
          "joins": {
            "by": "material",
            "rule": "Where walls meet, layers of the same material join without a line; core joins core, finishes wrap. Done by the application."
          },
          "level": "Placed on a storey; z = 0 is the storey elevation."
        },
        "opo::handles": [
          {
            "slot": "path",
            "kind": "points",
            "view": [
              "plan"
            ]
          },
          {
            "parameter": "unconnected_height",
            "view": [
              "elevation",
              "model"
            ],
            "at": "[path[1][1], path[1][2], top]",
            "axis": "z",
            "visible": "top_mode = \"unconnected\""
          }
        ],
        "opo::materials": {
          "brick_masonry": {
            "label": "Brick masonry",
            "category": "masonry",
            "colour": "#b5653f",
            "cut": {
              "hatch": "masonry"
            },
            "surface": {
              "hatch": "brick_stretcher_elevation"
            },
            "ifc_name": "Brick masonry"
          },
          "concrete_block": {
            "label": "Concrete block masonry",
            "category": "masonry",
            "colour": "#9e9b94",
            "cut": {
              "hatch": "block"
            },
            "ifc_name": "Concrete block masonry"
          },
          "mineral_wool": {
            "label": "Mineral wool insulation",
            "category": "insulation",
            "colour": "#e9d27a",
            "cut": {
              "hatch": "insulation_soft"
            },
            "ifc_name": "Mineral wool insulation"
          },
          "plaster": {
            "label": "Gypsum plaster",
            "category": "finish",
            "colour": "#efece5",
            "cut": {
              "hatch": "plaster"
            },
            "ifc_name": "Gypsum plaster"
          },
