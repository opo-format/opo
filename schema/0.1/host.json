{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opo-format.org/schema/0.1/host.json",
  "title": "opo::host",
  "description": "Host behaviour: what the object cuts, provides, attaches to (spec §4.7).",
  "type": "object",
  "properties": {
    "is_host": {
      "type": "boolean"
    },
    "accepts": {
      "type": "array",
      "items": {
        "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/ifcClass"
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/ifcClass"
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/expr"
      },
      "description": "FEEL values the host gives hosted objects. Walls provide at least thickness, face_front, face_back, exterior, layers, core_front, core_back, base and height (proposal 0004)."
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "length",
              "angle",
              "number",
              "integer",
              "boolean",
              "choice",
              "text",
              "material",
              "colour",
              "layers",
              "property_set"
            ]
          },
          "default": {},
          "from": {
            "type": "string",
            "description": "One of the names a host provides (proposal 0004): thickness, face_front, face_back, exterior, layers, core_front, core_back, base, height; or free text for other hosts."
          }
        }
      }
    },
    "void": {
      "type": "object",
      "required": [
        "geometry"
      ],
      "properties": {
        "geometry": {
          "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/name"
        },
        "ifc": {
          "type": "string"
        }
      }
    },
    "joins": {
      "type": "object",
      "properties": {
        "by": {
          "enum": [
            "material",
            "layer",
            "none"
          ]
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "insertion": {
      "type": "object",
      "properties": {
        "point": {
          "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/expr"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "flip": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "values": {
            "type": "array"
          }
        }
      }
    },
    "snap_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "point"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "point": {
            "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/expr"
          }
        }
      }
    },
    "level": {
      "type": "string"
    },
    "placement": {
      "type": "string"
    },
    "clearance": {
      "type": "string"
    },
    "mounting": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nested": {},
    "slab_opening": {
      "type": "object"
    },
    "seat": {
      "type": "object",
      "description": "Which plane of the host the object's y = 0 lines up with (proposal 0004).",
      "required": [
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "enum": [
            "axis",
            "face_front",
            "face_back",
            "core_front",
            "core_back",
            "core_centre"
          ]
        },
        "offset": {
          "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/expr"
        }
      }
    },
    "reveal": {
      "type": "array",
      "description": "How the host's layers finish at the sides of the void, by layer function (proposal 0004). Layers not listed stop square.",
      "items": {
        "type": "object",
        "required": [
          "function",
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "function": {
            "enum": [
              "structure",
              "insulation",
              "finish",
              "membrane",
              "air",
              "other"
            ]
          },
          "rule": {
            "enum": [
              "return",
              "stop"
            ]
          },
          "to": {
            "description": "Plane a returning layer runs to: a seat name, or 'frame' with frame_y.",
            "enum": [
              "axis",
              "face_front",
              "face_back",
              "core_front",
              "core_back",
              "core_centre",
              "frame"
            ]
          },
          "frame_y": {
            "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/expr"
          }
        }
      }
    },
    "head": {
      "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/expr",
      "description": "FEEL point list: the head line of the structural opening (proposal 0004)."
    },
    "sill": {
      "$ref": "https://opo-format.org/schema/0.1/common.json#/$defs/expr",
      "description": "FEEL point list: the bottom line of the opening (proposal 0004)."
    }
  }
}
